    {
      "name": "苇茎汤",
      "type": "Formula",
      "attributes": {
        "alias": "千金苇茎汤",
        "effect": "化浊排脓",
        "indication": "肺痈，热毒壅滞，痰瘀互结证。身有微热，咳嗽痰多，甚则咳吐腥臭脓血，胸中隐隐作痛，舌红苔黄腻，脉滑数",
        "usage": "研末，内苇汁中，煮取二升，服一升，再服，当吐如胶（现代用法：水煎服）"
      }
    },
