{
  "entities": [
    {
      "name": "普济消毒饮",
      "type": "Formula",
      "attributes": {
        "alias": "普济消毒蒡芩连,甘桔蓝根勃翘玄,升柴陈薄僵蚕入,大头瘟毒此方先。普及消毒芩连鼠,玄参甘桔兰根侣,升柴马勃连翘陈,薄荷僵蚕为末举。",
        "effect": "苦寒辛散",
        "indication": "大头瘟。恶寒发热，头面红肿灼痛，目不能开，咽喉不利，舌燥口渴，舌红苔白兼黄，脉浮数有力。",
        "taboo": "素体阴虚以及脾虚便溏者慎用。",
        "usage": "水煎服"
      }
    },
