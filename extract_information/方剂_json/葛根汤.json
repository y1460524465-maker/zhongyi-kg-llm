    {
      "name": "葛根汤",
      "type": "Formula",
      "attributes": {
        "effect": "发汗解表，升津舒筋",
        "indication": "外感风寒表实，恶寒发热，头痛，项背强几，身痛无汗，腹微痛，或下利，或干呕，或微喘，舌淡苔白，脉浮紧者",
        "usage": "上七味，以水1升，先煮麻黄、葛根，减至800毫升，去上沫，纳诸药，再煮取300毫升，去滓，每次温服150毫升，覆取微似汗"
      }
    },
