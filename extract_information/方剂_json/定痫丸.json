  "entities": [
    {
      "name": "定痫丸",
      "type": "Formula",
      "attributes": {
        "alias": null,
        "effect": "豁痰开窍，熄风镇惊",
        "indication": "主痫症，突然发作，晕仆在地，喉中痰鸣，发出类似猪、羊叫声，甚则抽搐目斜；亦治癫狂",
        "taboo": null,
        "usage": "每服6～9克，照五痫分引下：犬痫，杏仁5枚，煎汤化下；羊痫，薄荷1克，煎汤化下；马痫，麦冬6克，煎汤化下；牛痫，大枣2枚，煎汤化下；猪痫，黑料豆9克，煎汤化下。每日二至三次。方内加人参9克，尤佳"
      }
    },
