{
  "entities": [
    {
      "name": "八风续命汤",
      "type": "Formula",
      "attributes": {
        "effect": "祛风定痉，养血通脉，轻解阳明，温降寒饮",
        "indication": "卒半身不遂，手足拘急，不得屈伸，身体冷，或智或痴，或身强直不语，或生或死，狂言不可名状，角弓反张，或欲得食，或不用食，或大小便不利者",
        "usage": "上(口父)咀。以井花水9升，煮取3升，分3眼，1日2次，覆取汗"
      }
    },
