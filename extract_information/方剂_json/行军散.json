    {
      "name": "行军散",
      "type": "Formula",
      "attributes": {
        "alias": "武候行军散、诸葛行军散",
        "effect": "开窍、辟秽",
        "indication": "暑秽痧胀。吐泻腹痛，烦闷欲绝，头目昏晕，不省人事。并治口疮咽痛。点目去风热障翳；搐鼻可避时疫之气。",
        "taboo": "孕妇慎服",
        "usage": "每服三分至五分（0.3g～0.9g），凉开水调下，或点眼、搐鼻。"
      }
    },
