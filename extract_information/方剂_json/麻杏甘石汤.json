{
  "entities": [
    {
      "name": "麻杏甘石汤",
      "type": "Formula",
      "attributes": {
        "alias": "麻黄杏仁甘草石膏汤",
        "effect": "辛凉宣泄，清肺平喘",
        "indication": "外感风热，或风寒郁而化热，热壅于肺，而见咳嗽、气急、鼻煽、口渴、高热不退，舌红苔白或黄，脉滑数者；急慢性支气管炎、肺炎以及麻疹合并肺炎",
        "usage": "上四味，以水七升，煮麻黄，减二升，去上沫，内诸药，煮取二升，去滓。温服一升（现代用法：水煎温服）"
      }
    },
