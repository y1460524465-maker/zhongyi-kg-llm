    {
      "name": "人参养荣汤",
      "type": "Formula",
      "attributes": {
        "alias": null,
        "effect": "养血补气，养荣",
        "indication": "积劳虚损，四肢沉滞，骨肉酸疼，吸吸少气，行动喘啜，小腹拘急，腰背强痛，心虚惊悸，咽干唇燥，饮食无味，阴阳衰弱，悲忧惨戚，多卧少起；肺与大肠俱虚，咳嗽下痢，喘乏少气，呕吐痰涎",
        "taboo": "阴虚阳旺而致心悸、自汗、失眠、健忘诸症者不可用",
        "usage": "加生姜三片，大枣二枚，水煎服，早晚各一次，空腹服"
      }
