      "name": "清骨散",
      "type": "Formula",
      "attributes": {
        "alias": null,
        "effect": "清骨退蒸，滋阴潜阳",
        "indication": "骨蒸潮热证,表现为午後或夜间潮热,骨蒸心烦,形瘦盗汗,两颊潮红,手足心热,舌红少苔,脉细数;肺结核、其他慢性消耗性疾病等证属阴虚内热、虚劳骨蒸者",
        "taboo": "本方退热作用较强,而滋阴作用较弱。若阴虚较甚、潮热较轻者,不宜使用。",
        "usage": "水煎服;或研末,每日3次,每次9克,冲服。"
      }
