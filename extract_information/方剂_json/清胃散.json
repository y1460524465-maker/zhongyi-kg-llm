  "entities": [
    {
      "name": "清胃散",
      "type": "Formula",
      "attributes": {
        "effect": "清胃凉血",
        "indication": "胃火牙痛。牙痛牵引头疼，面颊发热，其齿喜冷恶热，或牙宣出血，或牙龈红肿溃烂，或唇舌腮颊肿痛，口气热臭，口干舌燥，舌红苔黄，脉滑数。本方常用于口腔炎、牙周炎、三叉神经痛等属胃火上攻者。",
        "taboo": "牙痛属风寒及肾虚火炎者不宜。",
        "usage": "上药为细末，都作一服，水一盏半，煎至七分，去滓，放冷服之（现代用法：作汤剂，水煎服）。"
      }
    },
