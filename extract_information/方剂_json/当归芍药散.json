    {
      "name": "当归芍药散",
      "type": "Formula",
      "attributes": {
        "effect": "疏肝健脾",
        "indication": "妇人妊娠，肝郁气滞，脾虚湿胜，腹中疠痛；现用于妇女功能性水肿、慢性盆腔炎、功能性子宫出血、痛经、妊娠阑尾炎，以及慢性肾炎、肝硬化腹水、脾功能亢进等属脾虚肝郁者",
        "usage": "每服6克，温酒送下，一日三次"
      }
    },
