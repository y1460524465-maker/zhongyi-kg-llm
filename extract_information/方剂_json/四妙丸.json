    {
      "name": "四妙丸",
      "type": "Formula",
      "attributes": {
        "alias": null,
        "effect": "燥湿健脾，清热燥湿，补肝肾，强筋骨，祛湿热，利筋络。四味合用，为治湿热痿证之妙剂",
        "indication": "湿热下注，两足麻木，筋骨酸痛等。用于治疗丹毒，急慢性肾炎，湿疹，骨髓炎，关节炎等",
        "taboo": "忌食酒、肥甘之品，阴虚者禁用",
        "usage": "水泛丸，每次6-9g，日2次口服，小儿酌减。规格1g/15粒"
      }
    },
