    {
      "name": "葛根加半夏汤",
      "type": "Formula",
      "attributes": {
        "alias": null,
        "effect": "解表散寒",
        "indication": "外感风寒，头痛，项背强直拘急，无汗，口不渴，呕逆，苔白，脉浮者",
        "taboo": null,
        "usage": "上八味，以水1升，先煮葛根、麻黄，减至800毫升，去白沫，纳诸药，煮取300毫升，去滓，温服100毫升，覆取微似汗"
      }
    },
