    {
      "name": "理冲汤",
      "type": "Formula",
      "attributes": {
        "alias": null,
        "effect": "补气化瘀，消癥散结",
        "indication": "妇女经闭不行，或产后恶露不尽，结为症瘕，以致阴虚作热，阳虚作冷，食少劳嗽，室女月闭血枯，男子劳瘵，脏腑症瘕积聚，气郁脾弱，满闷痞胀，不能饮食",
        "taboo": null,
        "usage": "用水600毫升，煎至将成，加好醋少许，滚数沸服"
      }
