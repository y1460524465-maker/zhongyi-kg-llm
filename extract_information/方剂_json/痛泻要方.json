    {
      "name": "痛泻要方",
      "type": "Formula",
      "attributes": {
        "alias": "白术芍药散",
        "effect": "泻肝补脾，使肝脾和调，运健湿除，自然痛泻俱止",
        "indication": "脾虚肝旺之痛泻。肠鸣腹痛，大便泄泻，泻必腹痛，泻后痛缓（或泻后仍腹痛），舌苔薄白，脉两关不调，左弦而右缓者",
        "usage": "或煎、或丸、或散皆可用"
      }
    },
