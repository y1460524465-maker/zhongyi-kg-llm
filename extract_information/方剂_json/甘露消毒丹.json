  "entities": [
    {
      "name": "甘露消毒丹",
      "type": "Formula",
      "attributes": {
        "alias": "普济解毒丹|甘露消毒丸",
        "effect": "清热解毒，利湿化浊",
        "indication": "湿温时疫，邪在气分。症见发热困倦，胸闷腹胀，肢酸，咽肿，颐肿口渴，身黄，小便短赤，淋浊，吐泻，舌苔淡白或腻或干黄者",
        "usage": "每服三钱，开水调下，或神曲糊丸，如弹子大，开水化服"
      }
    },
