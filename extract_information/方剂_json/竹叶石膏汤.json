{
  "entities": [
    {
      "name": "竹叶石膏汤",
      "type": "Formula",
      "attributes": {
        "alias": "竹叶汤,人参竹叶汤",
        "effect": "清热除烦，益气养阴，降逆止呕，调养胃气",
        "indication": "伤寒、温病、暑病余热未清，气津两伤证。身热多汗，心胸烦闷，气逆欲呕，口干喜饮，或虚烦不寐，舌红苔少，脉虚数",
        "taboo": "内有痰湿，或阳虚发热，均应忌用",
        "usage": "上七味，以水一斗，煮取六升，去滓，内粳米，煮米熟，汤成去米，温服一升，日三服"
      }
    },
