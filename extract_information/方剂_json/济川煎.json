    {
      "name": "济川煎",
      "type": "Formula",
      "attributes": {
        "alias": null,
        "effect": null,
        "indication": "老年肾虚。肾阳虚弱，精津不足证。大便秘结，小便清长，腰膝酸软，头目眩晕，舌淡苔白，脉沉迟。(本方常用于习惯性便秘、老年便秘、产后便秘等属于肾虚精亏肠燥者。)",
        "taboo": "凡热邪伤津及阴虚者忌用。虚甚者不必用枳壳。",
        "usage": "水一盅半，煎七分，食前服。（现代用法：作汤剂，水煎服）"
      }
