    {
      "name": "五虎追风散",
      "type": "Formula",
      "attributes": {
        "source": "《中医杂志》(1955；10)",
        "usage": "水煎服。用黄酒2两为引。眼前先将朱砂面5分冲下，每服后五心出汗即有效。但出汗与否，应于第2日再服，每日1付，服完3付后，第2日用艾灸伤口。"
      }
