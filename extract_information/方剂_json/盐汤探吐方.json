  "entities": [
    {
      "name": "盐汤探吐方",
      "type": "Formula",
      "attributes": {
        "alias": "盐汤",
        "effect": "涌吐",
        "indication": "宿食不消、干霍乱",
        "usage": "用极咸盐汤三升，热饮一升，刺口令吐宿食使尽，不吐更服，吐迄复饮，三吐乃住，静止。现代用法：将盐用开水调成饱和盐汤，每服200-300ml，服后探吐，以吐尽宿食为度。"
      }
    },
