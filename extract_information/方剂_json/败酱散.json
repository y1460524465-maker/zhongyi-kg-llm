    {
      "name": "败酱散",
      "type": "Formula",
      "attributes": {
        "alias": "附子汤、薏苡附子散",
        "effect": "利湿排脓，破血消肿",
        "indication": "肠痈内已成脓，身无热，肌肤甲错，腹皮急，如肿状，按之软，脉数。现用于急性阑尾炎脓肿已成，或慢性阑尾炎急性发作，腹部柔软，压痛不明显，并见面色苍白，脉弱等阳虚证候者。",
        "usage": "上药三味，杵为粗末。用水400毫升，煎至200毫升，顿服。"
      }
    },
