    {
      "name": "膈下逐瘀汤",
      "type": "Formula",
      "attributes": {
        "alias": null,
        "effect": "活血祛瘀，行气止痛",
        "indication": "膈下瘀阻气滞，形成痞块，痛处不移，卧则腹坠；肾泻久泻。现用于慢性活动性肝炎、血卟啉病、糖尿病、宫外孕、不孕症等属血瘀气滞者",
        "taboo": null,
        "usage": "水煎服。病轻者少服，病重者多服，病去药止"
      }
