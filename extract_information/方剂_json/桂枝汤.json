{
  "entities": [
    {
      "name": "桂枝汤",
      "type": "Formula",
      "attributes": {
        "alias": null,
        "effect": "解肌发表，调和营卫",
        "indication": "外感风寒表虚证。头痛发热，汗出恶风，鼻鸣干呕，苔白不渴，脉浮缓或浮弱者",
        "usage": "桂枝9g  芍药9g  甘草6g  生姜9g  大枣3枚"
      }
    },
    {
      "name": "桂枝加桂汤",
      "type": "Formula",
      "attributes": {
        "alias": null,
        "effect": "温通心阳，平冲降逆",
        "indication": "太阳病误用温针或发汗过多而发奔豚",
        "usage": "桂枝汤原方中桂枝加至15g"
      }
    },
    {
      "name": "桂枝加芍药汤",
      "type": "Formula",
      "attributes": {
        "alias": null,
        "effect": "调和气血，缓急止痛",
        "indication": "太阳病误下，邪陷太阳，腹满时痛者",
        "usage": "桂枝汤原方中芍药加至18g"
      }
    },
    {
      "name": "桂枝",
