      "name": "建瓴汤",
      "type": "Formula",
      "attributes": {
        "alias": null,
        "effect": "滋补肝肾，涵养肝木；潜镇风阳，降逆平冲；引血下行",
        "indication": "肝阳上亢，头目眩晕，耳鸣目胀，心悸健忘，烦躁不宁，舌强言语不利，口眼歪斜，半身麻木不遂，脉弦长而硬",
        "taboo": "若大便不实者去赭石；若畏凉者，以熟地易生地",
        "usage": "磨取铁锈浓水，煎上药服"
      }
