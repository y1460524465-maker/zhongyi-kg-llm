    {
      "name": "安宫牛黄丸",
      "type": "Formula",
      "attributes": {
        "alias": null,
        "effect": "清热解毒，豁痰开窍",
        "indication": "高热、烦躁、神昏、谵语、抽搐；热人心包，神昏谵语，兼有脏实者；温热病，热邪内陷心包，痰热壅闭心窍；中风昏迷、小儿惊厥属邪热内闭者",
        "taboo": null,
        "usage": "共为细末，炼密为丸，每丸3克，金箔为衣。每服一丸，大人病重体实者，一日服二次。甚至日三服；小儿服半丸，不知，再服半丸"
      }
