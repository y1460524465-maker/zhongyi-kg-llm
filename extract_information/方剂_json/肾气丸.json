{
  "entities": [
    {
      "name": "肾气丸",
      "type": "Formula",
      "attributes": {
        "alias": "八味肾气丸、崔氏八味丸、金匮肾气丸、桂附八味丸、桂附地黄丸",
        "effect": "温补肾气",
        "indication": "肾气不足，腰酸脚软，肢体畏寒，少腹拘急，小便不利或频数，舌质淡胖，尺脉沉细；及痰饮喘咳，水肿脚气，消渴，久泄。现用于糖尿病、甲状腺功能低下、慢性肾炎、肾上腺皮质功能减退及支气管哮喘等属于肾气不足者",
        "taboo": "如有咽干、口燥、舌红、少苔等肾阴不足，肾火上炎症状者不宜用",
        "usage": "每服15丸，用酒送下，加至20丸，一日三次"
      }
    },
