    {
      "name": "导赤散",
      "type": "Formula",
      "attributes": {
        "alias": "导赤汤",
        "effect": "清心利水养阴",
        "indication": "心经火热证。心胸烦热，口渴面赤，意欲饮冷，以及口舌生疮；或心热移于小肠，小便赤涩刺痛，舌红，脉数。",
        "taboo": "方中木通苦寒，生地阴柔寒凉，故脾胃虚弱者慎用。",
        "usage": "上药为末，每服三钱（9克），水一盏，入竹叶同煎至五分，食后温服（现代用法：水煎服，用量按原方比例酌情增减）。"
      }
    },
