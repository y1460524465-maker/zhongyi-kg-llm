  "entities": [
    {
      "name": "六和汤",
      "type": "Formula",
      "attributes": {
        "effect": "治心脾不调，气不升降，霍乱转筋，呕吐泄泻，寒热交作，痰喘咳嗽，胸膈痞满，头目昏痛，肢体浮肿，嗜卧倦怠，小便赤涩，并伤寒阴阳不分，冒暑伏热烦闷，或成痢疾，中酒烦渴畏食。妇人胎前、产后，并宜服之。",
        "usage": "每服四钱，水一盏半，生姜三片，枣子一枚，煎至八分，去滓，不拘时候服。"
      }
    },
