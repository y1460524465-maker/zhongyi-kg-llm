{
  "entities": [
    {
      "name": "升麻葛根汤",
      "type": "Formula",
      "attributes": {
        "alias": null,
        "effect": "解肌透疹",
        "indication": "麻疹初起。疹发不出，身热头痛，咳嗽，目赤流泪，口渴，舌红，苔薄而干，脉浮数。亦治带状疱疹、单纯性疮疹、水痘、腹泻、急性细菌性痢疾等属邪郁肌表，肺胃有热者。",
        "taboo": "若麻疹已透，或疹毒内陷而见气急而粗、喘息抬肩、鼻翼煽动者，则当禁用。",
        "usage": "上为粗末。每服9克 ，用水一盏半，煎取一中盏，去滓，稍热服，不拘时候，一日二三次。以病气去，身清凉为度。现代用法：作汤剂，水煎服，用量按原方比例酌减。"
      }
    },
