  "entities": [
    {
      "name": "紫雪丹",
      "type": "Formula",
      "attributes": {
        "alias": null,
        "effect": "清热解毒、熄风镇痉、开窍安神",
        "indication": "温热病，邪热内陷心包而致的高热烦躁、神昏谵语、痉厥、口渴唇焦，尿赤便闭，以及小儿热盛惊厥；乙脑、流脑、猩红热等急性热病，见高热神昏、抽搐痉厥、口渴唇焦等证；小儿麻疹，热毒内盛，疹色紫红，或透发不畅，见高热、喘促、昏迷，指纹紫红者",
        "taboo": null,
        "usage": "制成散剂，每服0.9～1.5克，每日1－2次，冷开水调下"
      }
    },
