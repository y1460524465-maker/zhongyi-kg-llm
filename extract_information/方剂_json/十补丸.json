    {
      "name": "十补丸",
      "type": "Formula",
      "attributes": {
        "alias": "大补丸",
        "effect": "温阳补肾，益精髓，进饮食",
        "indication": "肾阳亏损，下焦虚寒，脐腹强急，腰脚疼痛，遗泄白浊，大便滑泻，小便频数；或三消渴疾，饮食倍常，肌肉消瘦，阳事不举",
        "usage": "上药研为细末，酒糊为丸，如梧桐子大。每服30～50丸，温酒或盐汤送下"
      }
    },
