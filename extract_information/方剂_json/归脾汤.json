{
  "entities": [
    {
      "name": "归脾汤",
      "type": "Formula",
      "attributes": {
        "alias": "加味归脾汤、归脾养营汤、归脾丸",
        "effect": "健脾养心，益气补血",
        "indication": "心脾两虚，气血不足，心悸健忘，失眠多梦，发热，体倦食少，面色萎黄，舌质淡，苔薄白，脉细弱；以及脾不统血所致便血，妇女月经超前，量多色淡，或淋漓不止者。现用于心脏病，神经衰弱，贫血，功能性子宫出血，血小板减少性紫癜等属心脾气血两虚者",
        "usage": "加生姜、大枣，水煎服"
      }
    },
