    {
      "name": "银翘散",
      "type": "Formula",
      "attributes": {
        "alias": null,
        "effect": "辛凉透表，清热解毒",
        "indication": null,
        "taboo": null,
        "usage": "上杵为散，每服六钱（18克），鲜苇根汤煎，香气大出，即取服，勿过煮。病重者约二时一服，日三服，夜一服；轻者三时一服，日二服，夜一服。现代用法：加入芦根适量，水煎服，用量按原方比例酌情增减。"
      }
