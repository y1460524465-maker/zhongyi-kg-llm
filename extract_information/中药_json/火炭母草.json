{
  "entities": [
    {
      "name": "火炭母草",
      "type": "Herb",
      "attributes": {
        "alias": "火炭毛、乌炭子、运药、山荞麦草、黄鳝藤、晕药、乌白饭草、火炭星、鹊糖梅、赤地利、乌饭藤、水沙柑子、鸪鹚饭、水退痧、红梅子叶、白饭草、大叶沙滩子、老鼠蔗",
        "effect": "清热利湿，凉血解毒",
        "indication": "泄泻，痢疾，黄疸，风热咽疼，虚弱头昏，小儿疰夏，惊搐，妇女白带，痈肿湿疮，跌打损伤",
        "property_flavor": "味酸甘，性平，无毒；或味酸，性寒；或味微酸微涩，性微凉",
        "dosage": "内服：煎汤，9～15g,鲜品30～60g。外用：适量，捣敷；或煎水洗"
      }
    }
  ],
