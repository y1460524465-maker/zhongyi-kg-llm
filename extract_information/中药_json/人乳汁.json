{
  "entities": [
    {
      "name": "人乳汁",
      "type": "Herb",
      "attributes": {
        "effect": "补阴养血，润燥止渴",
        "indication": "虚劳赢瘦，虚风瘫痪，噎膈，消渴，血虚经闭，大便燥结，目赤昏暗",
        "taboo": "脏乞虚寒，滑泄不禁，及胃弱不思食，脾虚不磨食，并不宜服。脾虚易泻者勿食",
        "usage": "内服：新鲜乳乘热饮，适量。"
      }
    },
    {
      "name": "接命丹",
      "type": "Formula",
      "attributes": {
        "usage": "人乳二酒盏，香甜白者为佳，以好梨汁一酒盏，炖滚热，每日五更后一服，能消痰，补虚，生血。"
      }
    }
  ],
