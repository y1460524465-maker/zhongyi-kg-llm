{
  "entities": [
    {
      "name": "黄精",
      "type": "Herb",
      "attributes": {
        "alias": "龙衔、兔竹、垂珠、鸡格、米脯、菟竹、鹿竹、重楼、救穷、戊已芝、萎蕤、苟格、马箭、仙人余粮、气精、生姜、野生姜、米餔、野仙姜、山生姜、玉竹黄精、白及黄精、阳誉蕻、土灵芝、老虎姜、山捣臼、鸡头参、赖姜",
        "effect": "养阴润肺，补脾益气，滋肾填精",
        "indication": "阴虚劳嗽，肺燥咳嗽，脾虚乏力，食少口干，消渴，肾亏腰膝酸软，阳痿遗精，耳鸣目暗，须发早白，体虚赢瘦，风癞癣疾",
        "taboo": "中寒泄泻，痰湿痞满气滞者忌服",
        "dosage": "内服：煎汤，10~15g，鲜品30~60g；或入丸、散熬膏。外用：适量，煎汤洗；熬膏涂；或浸酒搽"
      }
    }
  ],
