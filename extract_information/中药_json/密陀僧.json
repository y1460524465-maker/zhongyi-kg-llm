    {
      "name": "密陀僧",
      "type": "Herb",
      "attributes": {
        "alias": "陀僧，没多僧，炉底，银池，淡银，金炉底，银炉底，金陀僧，蜜陀僧",
        "effect": "燥湿杀虫，收敛，防腐，解毒",
        "indication": "疮疡溃烂久不收敛，口疮，疥癣，狐臭，汗斑，（黑干）黯，酒皶鼻，烧烫伤，湿疹",
        "dosage": "内服：研末，1-3分；或入丸、散",
        "taboo": "不宜与狼毒同用。体虚寒者应禁用。"
      }
