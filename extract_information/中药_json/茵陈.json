    {
      "name": "茵陈蒿汤",
      "type": "Formula",
      "attributes": {
        "alias": null,
        "effect": "治阳明病，但头汗出，身无汗，剂颈而还，小便不利，渴引水浆，瘀热在里，身发黄者",
        "usage": "以水一斗二升，先煮茵陈，减六升，内二味，煮取三升，去滓分三服"
      }
    },
    {
      "name": "茵陈四逆汤",
      "type": "Formula",
      "attributes": {
        "alias": null,
        "effect": "治发黄，脉沉细迟，肢体逆冷，腰以上自汗",
        "usage": "上为粗末。分作四贴，水煎服"
      }
    },
    {
      "name": "茵陈汤",
      "type": "Formula",
      "attributes": {
        "alias": null,
        "effect": "治病人身如金色，不多语言，四肢无力，好眠卧，口吐粘液",
        "usage": "上二味粗捣筛。每服三钱匕，水一盏，煎至六分，去滓，食前温服，日三"
      }
    },
    {
      "name": "茵陈蒿散",
      "type": "Formula",
      "attributes": {
        "alias": null,
        "effect": "治风瘙瘾胗，皮肤肿痒",
        "usage": "上二味捣罗为散。每服一钱匕，冷蜜水调下，食后服"
      }
    },
    {
      "name": "茵陈丸",
      "type": "Formula",
      "attributes": {
        "alias": null,
        "effect": "治黄疸，遍身悉黄，小便如浓栀子汁",
        "usage": "四味捣筛蜜丸如梧子大。空腹，以米饮服二十丸，日一服，渐加至二十五丸，微利为度"
      }
    },
    {
      "name": "茵陈栀子黄连汤",
      "type": "Formula",
      "attributes": {
        "alias": null,
        "effect": "治大便自利而灰",
        "usage": "水二盏，煎至八分，去滓服"
      }
    },
    {
      "name": "茵陈散",
      "type": "Formula",
      "attributes": {
        "alias": null,
        "effect": "治热病发斑",
        "usage": "捣筛为散。每服四钱，以水一中盏，煎至六分，去滓，不计时候服"
      }
    },
