{
  "entities": [
    {
      "name": "茵陈",
      "type": "Herb",
      "attributes": {
        "alias": "因尘、马先、茵蔯蒿、因陈蒿、绵茵陈、绒蒿、细叶青蒿、臭蒿、安吕草、婆婆蒿、野兰蒿",
        "effect": "清热利湿，退黄",
        "indication": "湿热黄疸，小便不利，传染性黄疸型肝炎，风痒疮疥",
        "meridian": "脾经、胃经、肝经、胆经",
        "place": "菊科植物滨蒿或茵陈蒿的干燥地上部分",
        "property_flavor": "气清香，味微苦",
        "taboo": "非因湿热引起的发黄忌服；蓄血发黄者禁用；热甚发黄，无湿气者禁用",
        "usage": "内服：煎汤，10~15g；或入丸、散",
        "origin": "菊科植物滨蒿Artemisia scoparia Waldst. et Kit. 或茵陈蒿Artemisia capillaris Thunb.的干燥地上部分",
        "processing": "除去残根及杂质，搓碎或切碎。绵茵陈筛去灰屑",
        "traits": "绵茵陈：多卷曲成团状，灰白色或灰绿色，全体密被白色茸毛，绵软如绒；茵陈蒿：茎呈圆柱形，多分枝，表面淡紫色或紫色，有纵条纹，被短柔毛"
      }
    },
