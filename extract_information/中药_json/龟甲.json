    {
      "name": "大补丸",
      "type": "Formula",
      "attributes": {
        "effect": "降阴火，补肾水",
        "usage": "服七十丸，空心，盐白汤下"
      }
    },
    {
      "name": "补肾丸",
      "type": "Formula",
      "attributes": {
        "effect": "治痿厥，筋骨软，气血俱虚甚者",
        "usage": "每服七十丸，白汤下"
      }
    },
    {
      "name": "龟鹿二仙膏",
      "type": "Formula",
      "attributes": {
        "effect": "治虚损精极者，梦泄遗精，瘦削少气，目视不明等证",
        "usage": "初服一钱五分，渐加至三钱，空心，酒服"
      }
    },
    {
      "name": "龟柏姜栀丸",
      "type": "Formula",
      "attributes": {
        "effect": "治赤白带下，或时腹痛",
        "usage": "白汤下"
      }
    },
    {
      "name": "龟蜡丹",
      "type": "Formula",
      "attributes": {
        "effect": "治无名肿毒，对口疔疮，发背流注，无论初起、将溃、已溃",
        "usage": "每服三钱，日服三次，黄酒调下，以醉为度"
      }
    },
    {
      "name": "大定风珠",
      "type": "Formula",
      "attributes": {
        "effect": "治阴虚动风证。温病后期，脉气虚弱，舌绛苔少，有时时欲脱之势者",
        "usage": "上以水八杯，煮取三杯，去渣，入阿胶烊化，再入鸡子黄，分三次服"
      }
    },
    {
      "name": "三甲复脉汤",
      "type": "Formula",
      "attributes": {
        "effect": "治温病热邪久羁下焦，热深厥甚，脉细促，心中痛者",
        "usage": "水煎服"
      }
    },
    {
      "name": "白及酥龟版",
      "type": "Formula",
      "attributes": {
        "effect": "补肺止血，滋阴清热",
        "indication": "肺肾阴虚有热所致的咯血、衄血、吐血、尿血等",
        "usage": "每日2次，每次6g，温开水送服"
      }
    },
    {
      "name": "龟甲散",
      "type": "Formula"
    }
