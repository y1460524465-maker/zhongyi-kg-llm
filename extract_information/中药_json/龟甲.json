{
  "entities": [
    {
      "name": "龟甲",
      "type": "Herb",
      "attributes": {
        "alias": "龟板、乌龟壳、乌龟板、下甲、血板、烫板",
        "effect": "滋阴，潜阳，补肾，健骨",
        "indication": "肾阴不足，骨蒸劳热，吐血，衄血，久咳，遗精，崩漏，带下，腰痛，骨痿，阴虚风动，久痢，久疟，痔疮，小儿囟门不合",
        "property_flavor": "味微咸",
        "taboo": "孕妇或胃有寒湿者忌服",
        "origin": "本品为龟科动物乌龟Chinemys reevesii （Gray）的背甲及腹甲",
        "dosage": "内服：煎汤宜先煎，9～24克；熬膏或入丸、散"
      }
    },
