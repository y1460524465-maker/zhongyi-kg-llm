{
  "entities": [
    {
      "name": "常春藤",
      "type": "Herb",
      "attributes": {
        "alias": "土鼓藤、龙鳞薛荔、尖叶薜荔、三角风、三角尖、上树蜈蚣、爬墙虎、械枫、尖角枫、山葡萄、狗姆蛇、钻天风、百脚蜈蚣、钻矢风、枫荷梨藤、风藤草、犁头南枫藤、三角箭、土枫藤、散骨风、三叶木莲",
        "effect": "祛风，利湿，平肝，解毒",
        "indication": "风湿性关节炎，肝炎，头晕，口眼歪斜，衄血，目翳，痈疽肿毒",
        "origin": "五加科植物常春藤的茎、叶",
        "processing": "茎叶干用在生长茂盛季节采收，切段晒干；鲜用时可随采随用",
        "property_flavor": "味涩",
        "traits": "茎呈圆柱形，长短不一，直径1-1.5cm，表面灰绿色或灰棕色，有横长皮孔，嫩枝有鳞片状柔毛；质坚硬，不易折断，断面裂片状，黄白色。叶互生，革质，灰绿以，营养枝的叶三角状卵形，花枝和果枝的叶椭圆状卵形、椭圆状披地形。花黄绿以。果实圆球形，黄色或红色。气微",
        "taboo": null,
        "dosage": "内服：煎汤，6-15g，研末；或浸酒，捣汁。外用：适量，捣敷或煎汤洗"
      }
    },
