{
  "entities": [
    {
      "name": "川牛膝",
      "type": "Herb",
      "attributes": {
        "origin": "苋科植物川牛膝Cyathula officinalis Kuan 的干燥根",
        "effect": "祛风，利湿，通经，活血祛瘀",
        "indication": "风湿腰膝疼痛，脚痿筋挛，血淋，尿血，妇女经闭，癥瘕，胞衣不下，跌扑损伤",
        "dosage": "内服，煎汤，6～10g;或入丸、散；或泡酒",
        "taboo": "妇女月经过多，妊娠，梦遗滑精者忌用"
      }
    },
    {
      "name": "三妙丸",
      "type": "Formula",
      "attributes": {
        "effect": "治湿热下注，两脚麻木，或如火烙之热",
        "indication": "湿热下注，两脚麻木，或如火烙之热",
        "usage": "上为细末，面糊为丸，如梧桐子大，每服五、七十丸，空心姜、盐汤下"
      }
    },
    {
      "name": "玉女煎",
      "type": "Formula",
      "attributes": {
        "effect": "治胃热阴虚证",
        "indication": "头痛，牙痛，齿松牙衄，烦热干渴，舌红苔黄而干。亦治消渴，消谷善饥",
        "usage": "水煎服"
      }
    },
    {
      "name": "济川煎",
      "type": "Formula",
      "attributes": {
        "effect": "治肾虚便秘",
        "indication": "大便秘结，小便清长，腰膝酸软，舌淡苔白，脉沉迟",
        "usage": "水煎服"
      }
    }
  ],
