{
  "entities": [
    {
      "name": "茯苓",
      "type": "Herb",
      "attributes": {
        "effect": "渗湿利水，益脾和胃，宁心安神",
        "indication": "小便不利，水肿胀满，痰饮咳逆，呕哕，泄泻，遗精，淋浊，惊悸，健忘",
        "property_flavor": "味淡，无臭",
        "meridian": "心经；脾经；肺经；肾经",
        "dosage": "内服：煎汤，10~15g；或入丸散。宁心安神用朱砂拌",
        "taboo": "虚寒精滑或气虚下陷者忌服。忌米醋。如小便利或数，服之则损人目。如汗多入服之，损元气。病人肾虚，小水自利或不禁或虚寒精清滑，皆不得服。气虚下陷、水涸口干俱禁用",
        "traits": "菌核球形、卵形、椭圆形至不规则形，长10-30cm或者更长，重量也不等，一般重500-5000g。外面吸厚而多皱褶的皮壳，深褐色，新鲜时软干后变硬；内部白色或淡粉红色，粉粒状",
        "origin": "多孔菌科真菌茯苓 Poria cocos （Schw.）Wolf 的干燥菌核",
        "place": "分布于吉林、安徽、浙江、福建、台湾、河南、湖北、广西、四川、贵州、云南",
        "processing": "多于7～9月采挖，挖出后除去泥沙，堆置发汗后，摊开晾至表面干燥，再发汗，反复数次至现皱纹、内部水分大部散失后，阴干，称为茯苓个；或将鲜茯苓按不同部位切制，阴干，分别称为茯苓皮及茯苓块"
      }
    },
