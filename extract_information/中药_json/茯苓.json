    {
      "name": "五苓散",
      "type": "Formula",
      "attributes": {
        "effect": "治太阳病，发汗后，大汗出，胃中干，烦躁不得眠，脉浮，小便不利，微热消渴",
        "usage": "上五味，捣为散。以白饮和，服方寸匕，日三服"
      }
    },
    {
      "name": "防己茯苓汤",
      "type": "Formula",
      "attributes": {
        "effect": "治皮水，四肢肿，水气在皮肤中，四肢聂聂动",
        "usage": "上五味，以水六升，煮取二升，分温三服"
      }
    },
    {
      "name": "苓桂术甘汤",
      "type": "Formula",
      "attributes": {
        "effect": "治心下有痰饮，胸胁支满目眩",
        "usage": "上四味，以水六升，煮取三升，分温三服，小便则利"
      }
    },
    {
      "name": "小半夏加茯苓汤",
      "type": "Formula",
      "attributes": {
        "effect": "治卒呕吐，心下痞，膈间有水，眩悸",
        "usage": "上三味，以水七升煮取一升五合，分温再服"
      }
    },
    {
      "name": "茯苓泽泻汤",
      "type": "Formula",
      "attributes": {
        "effect": "治胃反吐而渴，欲饮水",
        "usage": "上六味，以水一斗，煮取三升，纳泽泻再煮取二升半，温服八合，日三服"
      }
    },
    {
      "name": "威喜丸",
      "type": "Formula",
      "attributes": {
        "effect": "治丈夫元阳虚惫，精气不固，余沥常流，小便白浊，梦寐频泄，及妇人血海久冷，白带、白漏、白淫，下部常湿，小便如米泔，或无子息",
        "usage": "上以茯苓为末，熔黄蜡为丸，如弹子大。空心细嚼，满口生津，徐徐咽服，以小便清为度"
      }
    },
    {
      "name": "茯苓酒",
      "type": "Formula",
      "attributes": {
        "effect": "治头风虚眩，暖腰膝，主五劳七伤",
        "usage": "茯苓粉同曲米酿酒饮"
      }
    },
