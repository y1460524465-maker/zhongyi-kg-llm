{
  "entities": [
    {
      "name": "砂仁",
      "type": "Herb",
      "attributes": {
        "effect": "化湿开胃，温脾止泻，理气安胎",
        "indication": "湿浊中阻，脘痞不饥，脾胃虚寒，呕吐泄泻，妊娠恶阻，胎动不安",
        "usage": "内服：煎汤，3~6g（不宜久煎），后下；或入丸、散",
        "traits": "气芳香而浓烈，味辛凉、微苦",
        "processing": "砂仁：除去杂质及果壳，捣碎。\\n盐砂仁：取净砂仁，用盐水浸泡拌匀，文火炒至微干，取出放凉。（每砂仁100斤用盐2斤8两，加适量开水溶化澄清）"
      }
