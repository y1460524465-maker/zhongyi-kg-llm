{
  "entities": [
    {
      "name": "续断",
      "type": "Herb",
      "attributes": {
        "alias": "龙豆、属折、接骨、南草、接骨草、鼓锤草、和尚头、川断、川萝卜根、马蓟、黑老鸦头、小续断、山萝卜",
        "effect": "补肝肾，续筋骨，调血脉，续折伤，止崩漏",
        "indication": "主治腰背酸痛，足膝无力，胎漏，崩漏，带下，遗精，跌打损伤，金疮，痔漏，痈疽疮肿",
        "dosage": "内服：煎汤，6~15g；或入丸、散。外用：鲜品适量，捣敷",
        "property_flavor": "味苦，微甜而后涩",
        "processing": "续断：洗净泥沙，除去残留根头，润透后切片晒干，筛去屑。炒续断：取续断片入锅内以文火炒至微焦为度。盐续断：取续断片入锅内，加入盐水拌炒至干透为度。(每续断片100斤，用食盐20斤加开水适量化水)酒续断：取续断片用酒拌匀吸干，入锅内以文火炒干为度。(每续断片100斤，用黄酒20斤)",
        "origin": "为川续断科植物川续断的根",
        "taboo": "1.《本草经集注》：地黄为之使。恶雷丸。2.《得配本草》：初痢勿用，怒气郁者禁用。"
      }
    },
