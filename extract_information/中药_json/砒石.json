{
  "entities": [
    {
      "name": "砒石",
      "type": "Herb",
      "attributes": {
        "alias": "砒黄、信砒、人言、信石",
        "effect": "外用蚀疮去腐，内服截疟，祛痰平喘",
        "indication": "用于痔瘘，瘰疬，痈疽，走马牙疳，癣疮，溃疡腐肉不脱；内服治哮喘，疟疾",
        "property_flavor": "肺经；大肠经；胃经；脾经",
        "dosage": "内服：入丸、散，0.03~0.075g；外用：研末撒、调敷或入膏药中贴之",
        "taboo": "本品有剧毒内服宜慎，不能持续服用，孕妇忌服。不能作酒剂内服。外用也不可过量，以防局部吸收中毒。畏水银。",
        "processing": "去净杂质，砸碎，装入砂罐内，用泥将口封严，置炉火中煅红，取出放凉，研为细粉。"
      }
    },
