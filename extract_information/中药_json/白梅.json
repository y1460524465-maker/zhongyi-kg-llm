    {
      "name": "白梅",
      "type": "Herb",
      "attributes": {
        "alias": "盐梅、霜梅、白霜梅",
        "effect": "利咽生津，涩肠止泻，除痰开噤，消疮，止血",
        "indication": "咽喉肿痛，烦渴呕恶，久泻久痢，便血，崩漏，中风惊痫，痰劂口噤，梅核气，痈疽肿毒，外伤出血",
        "origin": "《齐民要术》",
        "taboo": "多食损齿伤筋",
        "usage": "内服：煎汤、噙咽津液或入丸剂。外用：擦牙、捣敷或煅存性研末调敷",
        "property_flavor": "酸、咸"
      }
