    {
      "name": "泽泻汤",
      "type": "Formula",
      "attributes": {
        "alias": null,
        "effect": null,
        "indication": "治心下有支饮，其人苦冒眩",
        "taboo": null,
        "usage": "泽泻五两，白术二两。上二味，以水二升，煮取一升，分温服。"
      }
    },
    {
      "name": "三白散",
      "type": "Formula",
      "attributes": {
        "alias": null,
        "effect": null,
        "indication": "治冒暑霍乱，小便不利，头晕引饮",
        "taboo": null,
        "usage": "泽泻、白术、白茯苓各三钱。水-盏，姜五片，灯心十茎，煎八分，温服。"
      }
    },
    {
      "name": "泽泻散",
      "type": "Formula",
      "attributes": {
        "alias": null,
        "effect": null,
        "indication": "治妊娠遍身浮肿，上气喘急，大便不通，小便赤涩",
        "taboo": null,
        "usage": "泽泻，桑白皮（炒）、槟榔、赤茯苓各五分。姜水煎服。"
      }
    },
    {
      "name": "泽泻散",
      "type": "Formula",
      "attributes": {
        "alias": null,
        "effect": null,
        "indication": "治小儿齁蛤，膈上壅热，涎潮",
        "taboo": null,
        "usage": "泽泻一分，蝉衣（全者）二十一个，黄明胶（手掌大一片，炙令焦）。上为细末.每服一钱，温米汤调下，日进二服，未愈再服。"
      }
    },
    {
      "name": "泽泻散",
      "type": "Formula",
      "attributes": {
        "alias": null,
        "effect": null,
        "indication": "治风虚多汗，恶风寒颤",
        "taboo": null,
        "usage": "泽泻、防风（去皮）、牡蛎（煅赤）、苍术（米泔浸，去皮，炒）各一两，桂（去租皮）三分。上五味，捣罗为细散。每服二钱匕，温粥饮调下，不计时。"
      }
    },
    {
      "name": "泽泻散",
      "type": "Formula",
      "attributes": {
        "alias": null,
        "effect": null,
        "indication": "治虚劳膀胱气滞，腰中重，小便淋",
        "taboo": null,
        "usage": "泽泻一两，牡丹三分，桂心三分，甘草三分（炙微赤，锉），榆白皮三分（锉），白术三分，赤茯苓一两，木通一两（锉）。上药粗捣罗为散。每服三钱，以水一中盏，煎至六分，去滓，食前温服。"
      }
    },
    {
      "name": "泽泻汤",
      "type": "Formula",
      "attributes": {
        "alias": null,
        "effect": null,
        "indication": "治五种腰痛",
        "taboo": null,
        "usage": "泽泻半两，桂（去粗皮）三分，白术、白茯苓（去黑皮）、甘草（炙，锉）各一两，牛膝（酒浸，切，焙）、干姜（炮）各半两，杜仲（去粗皮，锉，炒）三分。上八味，粗捣筛。每服三钱匕，水一盏，煎至七分，去滓，空心、日午，夜卧温服。"
      }
    },
    {
      "name": "疝疾灵丹",
      "type": "Formula",
      "attributes": {
        "alias": null,
        "effect": null,
        "indication": "治一切疝疾疼痛，并阴囊大如斗，小便淋漓",
        "taboo": null,
        "usage": "泽泻一斤（分作四分，童便、盐水、醋、酒各浸七日，放日中晒干，炒），吴茱萸（炒）二两。上为末，老米打糊丸，每服三钱，空心盐汤下。"
      }
    },
    {
      "name": "泻心散",
      "type": "Formula",
      "attributes": {
        "alias": null,
        "effect": null,
        "indication": "治眼赤疼痛",
        "taboo": null,
        "usage": "甘草二钱，泽泻五钱，黄连五钱，草决明一钱。共为末，每服二钱，灯心汤调下。"
      }
    },
    {
      "name": "泽泻散",
      "type": "Formula",
      "attributes": {
        "alias": null,
        "effect": null,
        "indication": "治鼻（上匿下虫）疮",
        "taboo": null,
        "usage": "泽泻、郁金、栀子、甘草等分。为末，用甘草汤调服。"
      }
    },
