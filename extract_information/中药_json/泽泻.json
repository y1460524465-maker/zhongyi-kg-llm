{
  "entities": [
    {
      "name": "泽泻",
      "type": "Herb",
      "attributes": {
        "dosage": "内服：煎汤，6~12g；或入丸、散。",
        "effect": "利水渗湿，泄热通淋。",
        "indication": "治小便不利，水肿胀满，呕吐，泻痢，痰饮，脚气，淋病，尿血。",
        "taboo": "肾虚精滑无湿热者禁服。",
        "property_flavor": "味微苦",
        "traits": "气微",
        "processing": "除去茎叶及须根，洗净，用微火烘干，再撞去须根及粗皮。"
      }
    },
