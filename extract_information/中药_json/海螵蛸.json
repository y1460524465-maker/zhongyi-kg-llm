{
  "entities": [
    {
      "name": "海螵蛸",
      "type": "Herb",
      "attributes": {
        "alias": "乌鲗骨、乌贼鱼骨、乌贼骨、墨鱼骨、墨鱼盖",
        "effect": "收敛止血，固精止带，制酸止痛，收湿敛疮。主吐血，呕血，崩漏，便血，衄血，创伤出血，肾虚遗精滑精，赤白带下，胃痛嘈杂，嗳气泛酸，湿疹溃疡。",
        "indication": "主治胃痛吞酸，吐、衄、呕血，便血，崩漏带下，血枯经闭，腹痛癥瘕，虚疟泻痢，阴蚀烂疮。",
        "processing": "除去杂质，洗净，干燥，砸成小块。",
        "property_flavor": "味淡、味微咸",
        "origin": "本品为乌贼科动物无针乌贼Sepiella maindronide Rochebrune或金乌贼Sepia esculenta Hoyle的干燥内壳。",
        "taboo": "阴虚多热者不宜多服；久服易致便秘，可适当配润肠药同用。",
        "dosage": "内服：煎汤，10~30g；研末，1.5~3g。外用：适量，研末撒；或调敷；或吹耳、鼻。"
      }
    },
