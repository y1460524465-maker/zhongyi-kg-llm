{
  "entities": [
    {
      "name": "凉粉草",
      "type": "Herb",
      "attributes": {
        "effect": "清热利湿，凉血解暑",
        "indication": "急性风湿性关节炎，高血压，中暑，感冒，黄疸，急性肾炎，糖尿病",
        "dosage": "内服：煎汤，15~30g。作冷饮或浸酒",
        "processing": "将原药除去残根等杂质，快洗，润软，切长段，干燥，筛去灰屑",
        "traits": "本品呈段状。茎段方柱形，具四棱（有的压扁），宽1.5～3mm；表面褐色，有细纵纹，被棕色绒毛，有的可见节，节上具对生叶痕、断枝或须状不定根；切面浅灰黄色，中心有圆形髓或中空。叶较多，皱缩、破碎或切断；完整叶长1.5～4cm,宽1～1.5cm，黄绿色至棕绿色，长卵形，先端渐尖，基部渐收缩成叶柄，边缘有锯齿，两面密被长毛。花少见。质轻脆，嚼之有胶性。气微，味淡",
        "origin": "本品为唇形科植物凉粉草Mesona chinensis Benth.的干燥地上部分",
        "place": "分布于浙江、江西、台湾、广东、广西等地"
      }
    },
