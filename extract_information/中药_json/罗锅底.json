    {
      "name": "罗锅底",
      "type": "Herb",
      "attributes": {
        "effect": "清热，解毒，消肿，止痛",
        "indication": "咽喉肿痛，牙痛，目赤肿痛，菌痢，肠炎，胃痛，肝炎，尿路感染，疔肿",
        "property_flavor": "苦，寒",
        "dosage": "内服：煎汤，6-9g；研末，0.5-1g。外用：适量，捣敷；或研末调敷",
        "taboo": "脾虚胃寒者勿用",
        "processing": "2～3月发苗前，或9～10月地上部分枯萎后，挖取块根，除去芦头及根须，洗净泥沙，大者切块，晒干或微火炕干",
        "origin": "葫芦科植物大籽雪胆、可爱雪胆及中华雪胆等的块根",
        "place": "云南、贵州、四川等地"
      }
