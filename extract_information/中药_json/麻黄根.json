{
  "entities": [
    {
      "name": "麻黄根",
      "type": "Herb",
      "attributes": {
        "dosage": "内服：煎汤,3~10g；或入丸、散。",
        "effect": "止汗，实表气，固虚，消肺气、梅核气；敛汗固表。",
        "indication": "体虚自汗、盗汗；诸虚不足，津液不固，体常自汗，夜卧即甚，久而不止，羸瘠枯瘦，心忪惊惕，短气烦倦；虚汗无度；肾劳热，阴囊生疮；虚牢盗汗不止；大虚汗出欲死，若自汗不止；人汗劳不止；脚汗。",
        "origin": "麻黄科植物草麻黄Ephedra sinica Stapf 或中麻黄Ephedra intermedia Schrenk et C. A. Mey.",
        "place": null,
        "processing": "除去杂质，洗净，润透，切厚片，干燥。",
        "property_flavor": "味微苦",
        "taboo": null,
        "traits": null
      }
    },
