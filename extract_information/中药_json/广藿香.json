    {
      "name": "广藿香",
      "type": "Herb",
      "attributes": {
        "origin": "亚洲菲律宾等亚热带地区",
        "place": "广东、海南",
        "effect": "芳香化湿，和胃止呕，祛暑解表",
        "indication": "湿阻中焦之脘腹痞闵，食欲不振，呕吐，泄泻，外感暑湿之寒热头痛，湿温初起的发热身困，胸闵恶心，鼻渊，手足癣",
        "traits": "气香特异，叶微苦",
        "dosage": "煎汤，5~10g，鲜者加倍，不宜久煎；或入丸散",
        "taboo": "阴虚火旺，胃弱欲呕及胃热作呕，中焦火盛热极，温病热病，阳明胃家邪实作呕作胀，法并禁用"
      }
