      "type": "Herb",
      "attributes": {
        "effect": "凉血,止血,祛风湿,散肿毒",
        "indication": "吐血、衄血、尿血、血痢、肠风、崩漏，风湿痹痛，细菌性痢疾，高血压，咳嗽，丹毒，痄腮，烫伤",
        "property_flavor": "味苦涩、微辛",
        "usage": "内服：煎汤，6~15g,或入丸、散。外用：适量，煎水洗，捣敷或研末调敷",
        "taboo": "《药性论》：与酒相宜。\n②《本草述》：多食亦能倒胃"
      }
