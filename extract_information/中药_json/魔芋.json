{
  "entities": [
    {
      "name": "魔芋",
      "type": "Herb",
      "attributes": {
        "alias": "蒟蒻、蒻头、白蒟蒻、鬼芋、鬼头、花杆莲、茱芋、黑芋头、花便莲、虎掌、花伞把、蛇头草根、麻芋子、蛇六谷、雷星、鬼蜡烛、蛇头子、天六谷、星芋",
        "effect": "化痰消积，解毒散结，行瘀止痛",
        "indication": "痰嗽，积滞，疟疾，瘰疬，症瘕，跌打损伤，痈肿，疔疮，丹毒，烫火伤，蛇咬伤",
        "usage": "内服：煎汤，9-15g（需久煎2小时以上）；外用：适量，捣敷；或磨醋涂。",
        "taboo": "不宜生服。内服不宜过量。误食生品及炮制品，过量服用易产生中毒症状。",
        "property_flavor": null,
        "meridian": null,
        "origin": "天南星科魔芋属植物魔芋Anorphophallus konjac K. Koch，以球状块茎入药。夏秋采挖，除去地上茎叶及须根，洗净，阴凉处风干。",
        "place": "生长于疏林下、林缘、溪边，或栽培于园圃。分布于我国东南至西南一带。",
        "processing": "取原药材，除去杂质，洗净，润透，切厚片，干燥，筛去灰屑。",
        "traits": "呈扁圆形厚片，切面灰白色，有多数细小维管束小点，周边暗红褐色。有细小圆点及根痕，质坚硬，粉性，微有麻舌感。"
      }
    },
