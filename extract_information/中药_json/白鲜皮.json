{
  "entities": [
    {
      "name": "白鲜皮",
      "type": "Herb",
      "attributes": {
        "alias": "北鲜皮、藓皮、野花椒根皮、臭根皮",
        "effect": "祛风，燥湿，清热，解毒",
        "indication": "风热疮毒，疥癣，皮肤痒疹，风湿痹痛，黄疸",
        "meridian": "脾经；肺经；小肠经；胃经；膀胱经",
        "dosage": "内服：煎汤，6~15g；或入丸、散。外用：适量，煎水洗或研末敷",
        "taboo": "《本草经集注》：恶螵蛸、桔梗、茯苓、萆薢。《本草经疏》：下部虚寒之人，虽有湿证勿用。",
        "property_flavor": null,
        "origin": "《本经》",
        "place": null,
        "processing": "拣净杂质，除去粗皮，洗净，稍润，切片，晒干或酒拌炒。",
        "traits": "根皮呈卷筒状，长5~15cm，直径1~2cm，厚2~5mm。外表面灰白色或淡灰黄色，具细纵皱纹及细根痕，常有突起的颗粒状小点；内表面类白色，有细纵纹。质脆，折断时有粉尘飞扬，断面不平坦，略呈层片状，剥去外层，对光可见闪烁的小亮点。有羊膻气，味微苦。以条大、肉厚、包灰白、断面分居者为佳。"
      }
    }
  ],
