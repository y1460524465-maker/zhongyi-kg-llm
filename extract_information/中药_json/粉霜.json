{
  "entities": [
    {
      "name": "粉霜",
      "type": "Herb",
      "attributes": {
        "alias": "白雪、水银霜、白灵砂、白粉霜",
        "effect": "利水，通便，攻毒，蚀恶肉，杀虫",
        "indication": "牙痛，梅毒恶疮，水肿，臌胀，大小便闭，痈疽溃疡，湿疹，顽癣",
        "taboo": "内服宜慎，体弱及孕妇忌服",
        "dosage": "内服宜慎，体弱及孕妇忌服",
        "processing": "将轻粉纳于烧瓶中，密封瓶口，然后埋置于盛有细砂的瓦锅中，徐徐加热升华。升华终了后，将烧瓶取出，破坏其上部，放置之，稍冷则升华物自然剥离。取升华物入乳钵内研碎，水飞，再于滤纸上，以水、酒精等顺次洗涤，最后，加微温，干燥后即成粉霜。",
        "place": "产湖北、浙江、河北等地",
        "property_flavor": null,
        "meridian": null,
        "origin": null,
        "traits": "完整者成馒头形之块状；色白而有光泽，背面较平坦而粗糙，结晶形状不明显；顶部为簇生的针状结晶，质重而脆。研成粉末为白色。"
      }
    },
    {
      "name": "粉霜散",
      "type": "Formula",
      "attributes": {
        "alias": null,
        "effect": null,
        "indication": "小儿走马疳疮",
        "taboo": null,
        "usage": "先用盐浆水洗过，以纸拈子揾药，扫在疮上，每日三、四度。"
      }
    }
  ],
