{
  "entities": [
    {
      "name": "冬瓜子",
      "type": "Herb",
      "attributes": {
        "alias": "白瓜子、瓜子、瓜瓣、冬瓜仁、瓜犀",
        "effect": "清肺化痰，消痈排脓，利湿",
        "indication": "痰热咳嗽，肺痈，肠痈，白浊，带下，脚气，水肿，淋证",
        "origin": "为葫芦科植物冬瓜的种子",
        "property_flavor": "味微甜",
        "dosage": "内服：煎汤，10~15g；或研末服。外用：适量，研膏涂敷。",
        "traits": "种子长椭圆形或卵圆形，扁平，长1~1.5cm，宽0.5~1cm，厚约0.2cm。表面黄白色，略粗糙，边缘光滑或两面外缘各有1环纹。一端稍尖，有2个小突起，较大的突起上有珠孔，较小的为种脐，另一端圆钝。种皮稍硬而脆，剥去种皮，可见子叶2枚，白色，肥厚，胚根短小。体轻，富油性。气无，味微甜。以颗粒饱满、色白者为佳。",
        "processing": "拣净杂质，用时捣碎。或用文火微炒至黄白色。置干燥处，防虫蛀及鼠咬。"
      }
    },
