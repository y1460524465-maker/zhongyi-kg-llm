{
  "entities": [
    {
      "name": "桑叶",
      "type": "Herb",
      "attributes": {
        "effect": "祛风清热，凉血明目",
        "indication": "治风温发热，头痛，目赤，口渴，肺热咳嗽，风痹，瘾疹，下肢象皮肿",
        "dosage": "内服：煎汤，4.5～9g；或入丸、散。外用：适量，煎水洗或捣敷"
      }
    },
    {
      "name": "桑菊饮",
      "type": "Formula",
      "attributes": {
        "usage": "水二杯，煮取一杯，日二服",
        "indication": "治太阴风温，但咳，身不甚热，微渴者"
      }
    },
    {
      "name": "桑麻丸",
      "type": "Formula",
      "attributes": {
        "usage": "每服三钱，空腹时盐汤、临卧时温酒送下",
        "indication": "治肝阴不足，眼目昏花，咳久不愈，肌肤甲错，麻痹不仁"
      }
    },
    {
      "name": "独圣散",
      "type": "Formula",
      "attributes": {
        "usage": "每服三钱匕，冷腊茶调如膏，入麝香少许，夜卧含化咽津",
        "indication": "治吐血"
      }
    },
    {
