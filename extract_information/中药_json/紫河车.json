{
  "entities": [
    {
      "name": "紫河车",
      "type": "Herb",
      "attributes": {
        "alias": "胞衣、人胞、混沌皮、仙人衣、混沌衣、混元丹、佛袈裟、胎衣",
        "effect": "补气，养血，温肾益精",
        "indication": "治虚损，羸瘦，劳热骨蒸，咳喘，咯血，盗汗，遗精，阳痿，妇女血气不足，不孕或乳少",
        "taboo": "凡有表邪及实证者禁服，脾虚湿困纳呆者慎服",
        "usage": "内服：研末，每次1.5~3g，重症加倍；或入丸剂；新鲜胎盘，半个或1个，水煎服食，每星期2-3次",
        "origin": "为人科健康产妇的胎盘",
        "processing": "用新鲜的紫河车，横直割开血管，用水反复洗漂干净。另取花椒装人布袋中加水煎汤，去渣，将洗净之紫河车置花椒汤中煮2~3分钟，及时捞出，沥净水，以黄酒适量拌匀，再置笼屉中蒸透，取出，烘干。(每紫河车100个，用花椒4两，黄酒3斤)"
      }
    },
