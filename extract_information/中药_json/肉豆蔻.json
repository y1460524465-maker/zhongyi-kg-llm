{
  "entities": [
    {
      "name": "肉豆蔻",
      "type": "Herb",
      "attributes": {
        "effect": "温中行气，消食，涩肠止泻",
        "indication": "用于心腹胀痛，虚泻，冷痢，呕吐，宿食不消，食少呕吐",
        "property_flavor": "味辛辣、微苦",
        "processing": "煨肉豆蔻、蒸制、炒制、土制、制霜",
        "dosage": "内服：煎汤，1.5~6g；或入丸、散",
        "taboo": "大肠素有火热及中暑热泄暴注，肠风下血，胃火齿痛及湿热积滞方盛，滞下初起，皆不宜服"
      }
    },
    {
      "name": "四神丸",
      "type": "Formula",
      "attributes": {
        "effect": "温补脾肾，涩肠止泻",
        "indication": "脾肾虚弱，大便不实，饮食不思"
      }
    },
    {
      "name": "纯阳真人养脏汤",
      "type": "Formula",
      "attributes": {
        "indication": "泻痢日久，脾肾虚寒，日夜无度，腹痛喜温喜按，倦怠食少，及脱肛坠下"
      }
    },
    {
      "name": "肉豆蔻丸",
      "type": "Formula",
      "attributes": {
        "indication": "水湿胀如鼓、脾脏久冷滑泄不止、留饮宿食不消、妇人白带下腹内冷痛"
      }
    },
    {
      "name": "肉豆蔻散",
      "type": "Formula",
      "attributes": {
        "indication": "脾虚泄泻、水泻无度肠鸣腹痛、脾胃虚滑泄泻不止下痢赤白"
      }
    },
    {
      "name": "豆蔻汤",
      "type": "Formula",
      "attributes": {
        "indication": "一切冷气，心腹胀满，胸膈痞滞，哕逆呕吐，泄泻虚滑，水谷不消，困倦少力，不思饮食"
      }
    },
    {
      "name": "一字汤",
      "type": "Formula",
      "attributes": {
        "effect": "温中焦，治宿食"
      }
    },
    {
      "name": "人参散",
      "type": "Formula",
      "attributes": {
        "indication": "一切血痢腹痛"
      }
    },
    {
      "name": "止泻方",
      "type": "Formula",
      "attributes": {
        "indication": "泻"
      }
    },
    {
      "name": "豆蔻丸",
      "type": "Formula",
      "attributes": {
        "indication": "泻痢日久，肠胃虚寒，肠滑，糟粕不聚"
      }
    },
