    {
      "name": "猪肚",
      "type": "Herb",
      "attributes": {
        "effect": "补虚损，健脾胃",
        "indication": "虚劳赢瘦，劳瘵咳嗽，脾虚食少，消渴便数，泄泻，水肿脚气，妇人赤白带下，小儿疳积",
        "usage": "内服：煮食，适量；或入丸剂",
        "taboo": "外感未清、胸腹痞胜负者，均忌"
      }
    },
