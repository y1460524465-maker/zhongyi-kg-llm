{
  "entities": [
    {
      "name": "紫草",
      "type": "Herb",
      "attributes": {
        "alias": "藐、茈草、紫丹、紫芺、地血、紫草茸、鸦衔草、紫草根、山紫草、红石根、野紫草、野麻灯、大紫草、红紫草、紫根、紫草根子、红条紫草",
        "effect": "凉血，活血，清热，解毒",
        "indication": "治温热斑疹，湿热黄疸，紫癜，吐、衄、尿血，淋浊，热结便秘，烧伤，湿疹，丹毒，痈疡",
        "taboo": "胃肠虚弱、大便滑泄者慎服",
        "usage": "内服：煎汤，3-9g：或入散剂。外用：适量，熬膏或制油涂"
      }
    },
    {
      "name": "紫草散",
      "type": "Formula",
      "attributes": {
        "indication": "发斑疹"
      }
    },
    {
      "name": "紫草如圣汤",
      "type": "Formula",
      "attributes": {
        "indication": "治疮疹才初出，便急与服之，令毒减轻可"
      }
    },
    {
      "name": "紫草膏",
      "type": "Formula",
      "attributes": {
        "indication": "治热疮、小儿胎毒，疥癣，两眉生疮，或延及遍身瘙痒，或脓水淋沥，经年不愈"
      }
    },
    {
      "name": "紫草润肌膏",
      "type": "Formula",
      "attributes": {
        "indication": "治火烫，发泡腐烂"
      }
    },
