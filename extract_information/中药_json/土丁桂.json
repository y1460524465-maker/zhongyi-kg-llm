{
  "entities": [
    {
      "name": "土丁桂",
      "type": "Herb",
      "attributes": {
        "effect": "止咳平喘，清热利湿，散淤止痛",
        "dosage": "内服：煎汤，3-10g (鲜者30-60g)；或捣汁饮",
        "indication": "用于支气管哮喘，咳嗽，黄疸，胃痛，消化不良，急性肠炎，痢疾，泌尿系感染，白带，跌打损伤，腰腿痛",
        "processing": "夏、秋季采收，洗净，鲜用或晒干",
        "traits": "全草纤细，长20-50cm。根细长稍曲，棕褐色，直径约3mm。茎细圆柱形，直径约1mm，灰绿色或淡黄色，茎枝及叶均密被灰白色丝绒毛。叶到生，皱缩，展平后呈卵形或长矩圆形，长0.4-1cm，宽2-4mm，先端短尖，基部钝圆，全缘，中脉明显；质柔软。偶见残留小花于叶腋，气微，味苦"
      }
    },
