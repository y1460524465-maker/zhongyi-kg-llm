    {
      "name": "白芥子",
      "type": "Herb",
      "attributes": {
        "effect": "利气豁痰，温中散寒，通络止痛",
        "indication": "主治痰饮咳喘，胸胁胀满疼痛，反胃呕吐，中风不语，肢体痹痛麻木，脚气，阴疽，肿毒，跌打肿痛",
        "meridian": "肺经；肝经；脾经；胃经；心包经",
        "property_flavor": "淡黄白色，气微，味辛辣，粉碎湿润后，有特殊的辛烈臭气",
        "dosage": "内服：煎汤，3~10g；或入丸、散。外用：适量，研末调敷；治喘咳宜敷贴背部肺俞、心俞、膈痰饮",
        "taboo": "肺虚咳嗽、阴虚火旺者忌服",
        "place": "主产安徽、河南、山东、四川、河北、陕西、山西等地"
      }
    },
