  "entities": [
    {
      "name": "全蝎",
      "type": "Herb",
      "attributes": {
        "alias": "虿、奎、杜伯、主簿虫、虿尾虫、全虫、茯背虫、蝎子",
        "effect": "息风镇痉，攻毒散结，通络止痛",
        "indication": "用于小儿惊风，抽搐痉挛，中风口歪，半身不遂，破伤风，风湿顽痹，偏正头痛，疮疡，瘰疬",
        "dosage": "内服：煎汤，2~5g；研末入丸、散，每次0.5~1g；蝎尾用量为全蝎的1/3。外用：适量，研末掺、熬膏或油浸涂敷",
        "taboo": "血虚生风者及孕妇禁服",
        "property_flavor": "味咸",
        "traits": "气微腥"
      }
    },
