{
  "entities": [
    {
      "name": "地骨皮",
      "type": "Herb",
      "attributes": {
        "origin": "为茄科植物枸杞等的根皮",
        "property_flavor": "味微甘，后苦",
        "indication": "主治虚劳潮热，骨蒸盗汗，肺热咳喘，吐血，衄血，血淋，消渴，高血压，痈肿，恶疮",
        "effect": "清虚热，凉血",
        "traits": "筒状、槽状或不规则卷片，大小不一，一般长3-10cm，直径0.5-2cm，厚1-3mm。外表面土黄色或灰黄色，粗糙，有不规则纵裂纹，易成鳞片状剥落；内表面黄白色，具细纵条纹。质松脆，易折为民，折断面分内外两层；内层灰白色。气微",
        "alias": "杞根、地骨、地辅、地节、枸杞根、苟起根、枸杞根皮、山杞子根、甜齿牙根、红耳堕根、山枸杞根、狗奶子根皮、红榴根皮、狗地芽皮",
        "processing": "春初或秋后采挖，洗净泥土，剥下根皮，晒干",
        "dosage": "内服：煎汤，9~15g；大剂量可用15~30g",
        "taboo": "《医学入门》：忌铁。《本草汇言》：虚劳火旺而脾胃薄弱，食少泄泻者宜减之。《本草正》：假热者勿用"
      }
    },
