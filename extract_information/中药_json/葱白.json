    {
      "name": "葱白",
      "type": "Herb",
      "attributes": {
        "dosage": "煎汤，9~15g；或酒煎。煮粥食，每次可用鲜品15~30g",
        "effect": "发表，通阳，解毒",
        "indication": "伤寒寒热头痛，阴寒腹痛，虫积内阻，二便不通，痢疾，痈肿",
        "origin": "百合科葱属植物葱Allium fistulosum L.",
        "property_flavor": null,
        "taboo": "食生葱即啖蜜，变作下利；上冲人，五脏闭绝；虚人患气者，多食发气；久食令人多忘，尤发痼疾；狐臭人不可食；服地黄、常山入，忌食葱；病人表虚易汗者勿食，病已得汗勿再进",
        "traits": "鳞茎圆柱形，先端稍肥大，鳞叶成层，白色，上具白色纵纹"
      }
    },
