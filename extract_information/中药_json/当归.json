{
  "entities": [
    {
      "name": "当归",
      "type": "Herb",
      "attributes": {
        "dosage": "内服：煎汤，6~12g；或入丸、散；或浸酒；或敷膏。",
        "effect": "补血活血，调经止痛，润肠通便。",
        "indication": "用于血虚萎黄，眩晕心悸，月经不调，经闭痛经，虚寒腹痛，肠燥便秘，风湿痹痛，跌扑损伤，痈疽疮疡。",
        "origin": "伞形科植物当归Angelica sinensis （Oliv.） Diels 的干燥根",
        "place": "主产于甘肃、云南。此外，陕西、四川、湖北、贵州等地亦产。",
        "property_flavor": "味甘、辛、微苦",
        "taboo": "湿阻中满及大便溏泄者慎服。",
        "traits": "有浓郁的香气"
      }
    },
    {
      "name": "酒当归",
      "type": "Herb",
      "attributes": {
        "dosage": null,
        "effect": "活血通经",
        "indication": "用于经闭痛经，风湿痹痛，跌扑损伤。",
        "origin": null,
        "place": null,
        "property_flavor": null,
