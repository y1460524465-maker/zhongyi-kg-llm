        "traits": null
      }
    },
    {
      "name": "当归身",
      "type": "Herb",
      "attributes": {
        "dosage": null,
        "effect": "补血",
        "indication": "用于血虚萎黄，经少，眩晕，经络不利，崩漏。",
        "origin": null,
        "place": null,
        "property_flavor": null,
        "taboo": null,
        "traits": null
      }
    },
    {
      "name": "当归尾",
      "type": "Herb",
      "attributes": {
        "dosage": null,
        "effect": "活血祛瘀",
        "indication": "用于瘀血阻滞，经少经闭，经行腹痛，跌扑损伤，瘀滞经络，痈疽疮疡。",
        "origin": null,
        "place": null,
        "property_flavor": null,
        "taboo": null,
        "traits": null
      }
    },
    {
      "name": "当归补血汤",
      "type": "Formula",
      "attributes": {
        "alias": null,
        "effect": null,
        "indication": "治肌热燥热，困渴引饮，目赤面红，昼夜不息，其脉洪大而虚，重按全无",
        "taboo": null,
        "usage": "黄耆（黄芪）一两，当归（酒洗）二钱。上药作一服，水二盏，煎至一盏，去滓，温服，空心食前。"
      }
    },
    {
      "name": "四物汤",
      "type": "Formula",
      "attributes": {
        "alias": null,
        "effect": "调益荣卫，滋养气血。治冲任虚损",
        "indication": "月水不调，脐腹疞痛，崩中漏下，血瘕块硬，发歇疼痛，妊娠宿冷，将理失宜，胎动不安，血下不止，及产后乘虚，风寒内搏，恶露不下，结生瘕聚，少腹坚痛，时作寒热",
        "taboo": null,
        "usage": "当归（去芦，酒浸，炒）、川芎、白芍药、熟地黄（酒洒蒸）各等分。共为粗末。每服三钱，水一盏半，煎至八分，去渣热服，空心食前。"
      }
    },
    {
      "name": "当归芍药散",
      "type": "Formula",
      "attributes": {
        "alias": null,
        "effect": null,
        "indication": "治妇人怀娠，腹中疞痛",
        "taboo": null,
        "usage": "当归三两，芍药一斤，茯苓四两，白术四两，泽泻半斤，芎藭半斤。上杵为散，取方寸匕，酒和，日三服。"
      }
    },
    {
      "name": "当归苦参丸",
      "type": "Formula",
      "attributes": {
        "alias": null,
        "effect": null,
        "indication": "治妊娠小便难，饮食如故",
        "taboo": null,
        "usage": "当归、贝母(川贝母)、苦参各四两。三味末之，炼蜜丸如小豆大，饮服三丸，加至十丸。"
      }
    },
    {
      "name": "当归生姜羊肉汤",
      "type": "Formula",
      "attributes": {
        "alias": null,
        "effect": null,
        "indication": "治产后腹中疞痛，并腹中寒疝虚劳不足",
        "taboo": null,
        "usage": "当归三两，生姜五两，羊肉一斤。上三味，以水八升，煮取三升，温服七合，日三服。"
      }
    }
  ],
