{
  "entities": [
    {
      "name": "翻白草",
      "type": "Herb",
      "attributes": {
        "alias": "鸡腿儿、天藕儿、湖鸡腿、鸡脚草、鸡脚爪、鸡距草、独脚草、鸡腿子、乌皮浮儿、天青地白、金钱吊葫芦、老鸹枕、老鸦爪、山萝卜、土菜、结梨、大叶铡草、白头翁、鸡爪莲、郁苏参、土人参、野鸡坝、兰溪白头翁、黄花地丁、千锤打、叶下白、茯苓草",
        "origin": "为蔷薇科植物翻白草的全草",
        "effect": "清热，解毒，凉血止血，消肿",
        "indication": "治痢疾，疟疾，肺痈，咳血，吐血，下血，崩漏，痈肿，疮癣，瘰疬结核",
        "taboo": "阳虚有寒、脾胃虚寒等少用",
        "dosage": "内服：煎汤，10~15g；或浸酒服。外用：适量，煎水熏洗或鲜品捣敷"
      }
