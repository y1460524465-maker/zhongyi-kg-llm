{
  "entities": [
    {
      "name": "雷丸",
      "type": "Herb",
      "attributes": {
        "dosage": "15～21g，不宜入煎剂，一般研粉服。一次5～7g，饭后用温开水调服，一日3次，连服3天。",
        "effect": "杀虫消积",
        "indication": "用于绦虫、钩虫、蛔虫病，虫积腹痛，小儿疳积。",
        "origin": "多孔菌科植物雷丸菌的菌核",
        "place": "主产四川、贵州、云南、湖北、广西、陕西。此外，浙江、湖南、广东、安徽、福建等省亦产。",
        "processing": "洗净，晒干，粉碎。不得蒸煮或高温烘烤。",
        "property_flavor": "味淡",
        "taboo": "有虫积而脾胃虚寒者慎服。",
        "traits": "菌核体通常为不规则的坚硬块状，歪球形或歪卵形，直径0.8～2.5厘米，罕达4厘米，表面黑棕色，具细密的纵纹；内面为紧密交织的菌丝体，蜡白色，半透明而略带粘性，具同色的纹理。"
      }
    }
  ],
