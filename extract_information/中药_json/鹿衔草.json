  "entities": [
    {
      "name": "鹿衔草",
      "type": "Herb",
      "attributes": {
        "alias": "鹿蹄草、小秦王草、破血丹、纸背金牛草、大肺筋草、红肺筋草、鹿寿茶、鹿安茶、鹿含草",
        "effect": "补虚，益肾，祛风除湿，活血调经",
        "indication": "虚弱咳嗽，劳伤吐血，风湿关节痛，崩漏，白带，外伤出血",
        "processing": "拣去杂质，筛去泥沙，洗净，稍润，切细，晒干",
        "property_flavor": "气无，味微苦",
        "dosage": "内服：煎汤，15~30g；研末，6~9g；外用：适量，捣敷或研撒；或煎水洗"
      }
    },
