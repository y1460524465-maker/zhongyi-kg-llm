  "entities": [
    {
      "name": "蒲公英",
      "type": "Herb",
      "attributes": {
        "dosage": "内服：煎汤，10~30g，大剂量60g；或捣汁；或入散剂。",
        "effect": "清热解毒，利尿散结。",
        "indication": "主治急性乳腺炎，淋巴腺炎，瘰疬，疔毒疮肿，急性结膜炎，感冒发热，急性扁桃体炎，急性支气管炎，胃炎，肝炎，胆囊炎，尿路感染。",
        "taboo": "阳虚外寒、脾胃虚弱者忌用。"
      }
    }
  ],
