{
  "entities": [
    {
      "name": "薏苡仁",
      "type": "Herb",
      "attributes": {
        "alias": "解蠡、起英、赣米、感米、薏珠子、回回米、草珠儿、赣珠、薏米、米仁、薏仁、苡仁、玉秣、六谷米、珠珠米、药玉米、水玉米、沟子米、裕米、益米",
        "dosage": "内服：煎汤，10~30g；或入丸、散，浸酒，煮粥，作羹。",
        "effect": "健脾，补肺，清热，利湿。",
        "indication": "治泄泻，湿痹，筋脉拘挛，屈伸不利，水肿，脚气，肺痿，肺痈，肠痈，淋浊，白带。",
        "origin": "《本经》",
        "place": "主产福建、河北、辽宁。",
        "processing": "炒薏苡仁：取拣净的薏苡仁置锅内用文火炒至微黄色，取出，放凉即可。或用麸皮同炒亦可。（每薏苡仁100斤，用麸皮10斤）",
        "property_flavor": "味微甜",
        "taboo": "本品力缓，宜多服久服。脾虚无湿，大便燥结及孕妇慎服。",
        "traits": "种仁宽卵形或长椭圆形，长4~8mm，宽3~6mm。表面乳白色，光滑，偶有残存的黄褐色种皮。一端钝圆，另端较宽而微凹，有1淡棕色点状种脐。背面圆凸，腹面有1条罗宽而深的纵沟。质坚实，断面白色粉质。气微。"
      }
    },
