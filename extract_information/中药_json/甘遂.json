    {
      "name": "十枣汤",
      "type": "Formula",
      "attributes": {
        "usage": "强人服一钱匕，羸人服半钱，温服之，平且服。若下少，病不除者，明日更服，加半钱，得快下利后，糜粥自养。"
      }
    },
    {
      "name": "甘遂半夏汤",
      "type": "Formula",
      "attributes": {
        "usage": "以水二升，煮取半升，去滓，以蜜半升，和药汁煎取八合，顿服之。"
      }
    },
    {
      "name": "大黄甘遂汤",
      "type": "Formula",
      "attributes": {
        "usage": "以水三升，煮取一升，顿服之，其血当下。"
      }
