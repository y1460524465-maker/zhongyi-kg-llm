{
  "entities": [
    {
      "name": "甘遂",
      "type": "Herb",
      "attributes": {
        "alias": "主田,重泽,甘藁,陵藁,甘泽,苦泽,白泽,鬼丑,陵泽,肿手花根,九头狮子草,化骨丹,肿手花,头痛花,猫儿眼",
        "effect": "泻水饮，破积聚。通二便。治水肿胀满，留饮，结胸，气逆喘咳，痢痫，噎膈，癥瘕积聚，二便不通。",
        "indication": "主治水肿胀满，留饮，结胸，痢痫，噎膈，癥瘕积聚，气逆喘咳，二便不通。",
        "meridian": "脾经；肺经；肾经；膀胱经；大肠经；小肠经",
        "property_flavor": "味微甘、辛，有刺激性",
        "dosage": "内服：入丸、散，0.5~1g。外用：适量，研末调敷。内服宜用炮制品。",
        "taboo": "气虚、阴伤、脾胃衰弱者及孕妇忌服。"
      }
    },
