{
  "entities": [
    {
      "name": "黄芩",
      "type": "Herb",
      "attributes": {
        "effect": "泻实火，除湿热，止血，安胎",
        "indication": "壮热烦渴，肺热咳嗽，湿热泻痢，黄疸，热淋，吐、衄、崩、漏，目赤肿痛，胎动不安，痈肿疔疮",
        "meridian": "归肺经、胆经、脾经、大肠经、小肠经",
        "processing": "1.黄芩：拣去杂质，除去残茎，用凉水浸润或置开水中稍浸捞出，润透后切片晒干（注意避免曝晒过度发红）。2.酒黄芩：取黄芥片喷淋黄酒，拌匀，用文火微炒，取出，晾干。（每黄芩100斤，用黄酒10-15斤）3.炒黄芩：取黄芩片用文火炒至表面微焦为度，取出，放凉。4.黄芩炭：取黄芩片用武火炒至表面焦褐色、边缘带黑色为度，但须存性，喷淋清水，取出，晒干。",
        "property_flavor": "味苦",
        "dosage": "内服：煎汤，3~9g；或入丸、散。外用：适量，煎水洗；或研末调敷。",
        "taboo": "《本草经疏》：脾肺虚热者忌之。凡中寒作泄，中寒腹痛，肝肾虚而少腹痛，血虚腹痛，脾虚泄泻，肾虚溏泻，脾虚水肿，血枯经闭，气虚小水不利，肺受寒邪喘咳，及血虚胎不安，阴虚淋露，法并禁用。",
        "alias": "腐肠、黄文、妒妇、虹胜、经芩、印头、内虚、空肠、子芩、宿芩、条芩、元芩、土金茶根、山茶根、黄金条根",
        "origin": "为唇形科植物黄芩的根",
        "place": "主产河北、内蒙古、山西、山东、陕西等地。此外，辽宁、黑龙江亦产。四川、云南所产的黄芩，为植物滇黄芩的根。"
      }
    },
