{
  "entities": [
    {
      "name": "羌活",
      "type": "Herb",
      "attributes": {
        "alias": "羌青、护羌使者、胡王使者、羌滑、退风使者、黑药",
        "effect": "解表散寒，祛风胜湿，止痛",
        "indication": "阳痿遗精，遗尿尿频，腰膝冷痛，肾虚作喘，五更泄泻；外用治白癜风，斑秃",
        "usage": "内服：煎汤，3~10g；或入丸、散",
        "property_flavor": "味微苦而辛",
        "processing": "栽培3~4年秋季倒苗后至早春萌芽前割除地上部分，挖取根茎，抖净泥沙，砍去芦头，除须根，切成10~13cm长的短节，晒干或烘干"
      }
    },
