{
  "entities": [
    {
      "name": "黄荆子",
      "type": "Herb",
      "attributes": {
        "effect": "祛风，除痰，行气，止痛",
        "indication": "感冒，咳嗽，哮喘，风痹，疟疾，胃痛，疝气，痔漏",
        "dosage": "内服：煎汤，5~10g；或入丸、散",
        "taboo": "凡湿热燥渴无气滞者忌用",
        "traits": "干燥果实圆球形，上端稍大略平而圆，下端稍尖，长约3毫米，径约2毫米；宿萼灰褐色，密被棕色细绒毛，包围整个果实的2/3左右，但多半已脱落；基部具短柄；果实外表棕褐色，较光滑，表面纵脉纹明显，果皮较厚，质较硬，不易破碎。内藏白色种子数枚。气香，味苦带涩。以颗粒饱满、干燥、少宿萼、无杂质为佳。",
        "origin": "马鞭草科植物黄荆的果实",
        "processing": "秋季果实成熟时采收，用手搓下，晒干，扬净"
      }
    },
