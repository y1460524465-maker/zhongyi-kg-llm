{
  "entities": [
    {
      "name": "星宿菜",
      "type": "Herb",
      "attributes": {
        "alias": "假辣蓼、泥鳅菜、红根草、红气根、红七草、金鸡脚、百煎草、蛙霓草、黄鳅窜、红头绳、血丝草、红灯心、红筋仔、大田基黄、麻雀利、红筋草、地木回、拔血红、红香子、红梗草、田岸柴、定经草、水柯、红根仔、矮荷子",
        "property_flavor": "微苦涩，平（《福建民间草药》）；味酸苦，性微温（《闽东本草》）",
        "effect": "活血，散瘀，利水，化湿",
        "indication": "跌打损伤，关节风湿痛，妇女经闭，乳痈，瘰疬，目赤肿痛，水肿，黄疸，疟疾，痢疾",
        "dosage": "内服：煎汤，3～5钱（鲜者1～3两）；外用：捣敷或煎水熏洗",
        "origin": "为报春花科植物星宿菜的全草或带根全草"
      }
    },
