    {
      "name": "覆盆子",
      "type": "Herb",
      "attributes": {
        "alias": "覆盆、乌藨子、小托盘、山泡、竻藨子",
        "effect": "补肝肾，助阳，固精缩尿，明目",
        "indication": "用于虚劳，目暗，肾虚遗尿，小便频数，阳痿早泄，遗精滑精",
        "usage": "内服：煎汤，5~10g；或入丸、散，亦可浸酒或熬膏",
        "taboo": "肾虚有火，小便短涩者慎服"
      }
