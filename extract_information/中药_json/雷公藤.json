      "name": "雷公藤",
      "type": "Herb",
      "attributes": {
        "origin": "卫矛科植物雷公藤的木质部",
        "effect": "祛风除湿，活血通络，消肿止痛，解毒杀虫",
        "indication": "类风湿性关节炎，风湿性关节炎，肾小球肾炎，肾病综合征，红斑狼疮，口眼干燥综合征，白塞病，湿疹，银屑病，麻风病，疥疮，顽癣",
        "taboo": "本品有大毒。内服宜慎。敷药时间不可超过半小时，否则起泡",
        "dosage": "内服：煎汤，去皮根木质部分15~25g；带皮根10~12g。均需文火煎1~2h。也可制成糖浆、浸膏片等。岩研粉装胶囊服，每次0.5~1.5g，每日3次。外用：适量，研粉或捣烂或；或制成酊剂、软膏涂擦",
        "property_flavor": "味苦徽辛",
        "traits": "有大毒"
      }
    }
