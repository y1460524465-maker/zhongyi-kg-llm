    {
      "name": "豆蔻",
      "type": "Herb",
      "attributes": {
        "alias": "多骨、壳蔻、白蔻、圆豆蔻、扣米、豆蔻",
        "effect": "化湿行气，温中止呕，开胃消食",
        "indication": "湿阻气滞，脾胃不和，脘腹胀满，不思饮食，湿温初起，胸闷不饥，胃寒呕吐，食积不消",
        "taboo": "阴虚血燥而无寒湿者忌服",
        "dosage": "内服:煎服，（不宜久煎），1.5~6g，或入丸、散",
        "property_flavor": "气芳香，味辛凉",
        "origin": "姜科植物白豆蔻和爪哇白豆蔻成熟的果实",
        "place": "广东、云南栽培；海南、云南栽培"
      }
