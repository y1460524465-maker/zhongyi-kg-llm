  "entities": [
    {
      "name": "木蝴蝶",
      "type": "Herb",
      "attributes": {
        "alias": "千张纸、兜铃、磊刀树、三百两银药、玉蝴蝶、云故纸、破布子、白故纸、海船果心、白玉纸、白千层、纸肉、故纸、洋故纸、鸭船层纸、千纸肉、海船皮、满天飞",
        "origin": "本品为紫葳科植物木蝴蝶Oroxylum indicum （L.）Vent.的干燥成熟种子。秋、冬二季采收成熟果实，曝晒至果实开裂，取出种子，晒干。",
        "effect": "润肺，舒肝，和胃，生肌",
        "indication": "主治咳嗽，喉痹，音哑，肝胃气痛，疮口不敛。治干咳不止常配夏枯草。",
        "dosage": "内服：煎汤，6~9g；研末，1.5~3g。外用：适量，敷贴；或研末撒患处。"
      }
