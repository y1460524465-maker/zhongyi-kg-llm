{
  "entities": [
    {
      "name": "玄精石",
      "type": "Herb",
      "attributes": {
        "dosage": "内服：煎汤，3～15g，用时捣碎，先煎；或入丸、散。",
        "effect": "滋阴，降火，软坚，消痰。",
        "indication": "阳盛阴虚，壮热烦渴，头风脑痛，目赤障翳，重舌，木舌，咽喉肿痛，头疮，水火烫伤。",
        "property_flavor": "味微咸",
        "traits": "本品为类圆形、长条形或不规则的片状物，长约至2cm，边缘薄，中间厚，有的形似龟背。灰白色或略带淡灰棕色，有的中间夹杂黑色斑纹，半透明。质坚脆，折断面显玻璃样光泽。气微。"
      }
    },
    {
      "name": "正阳丸",
      "type": "Formula",
      "attributes": {
        "usage": "先用热水浴后，以艾汤研下一丸，以衣盖汗出为度。"
      }
    },
    {
      "name": "来复丹",
      "type": "Formula",
      "attributes": {
        "usage": "每服三十粒，空心粥饮下，甚者五十粒，小儿三、五粒，新生婴儿一粒。"
      }
    },
    {
      "name": "玄精丸",
      "type": "Formula",
      "attributes": {
        "usage": "每于食前，以粥饮下十丸。"
      }
    },
    {
      "name": "珍珠散",
      "type": "Formula",
      "attributes": {
        "usage": "每服半钱，新汲水调下。"
      }
    },
    {
      "name": "玄精石散",
      "type": "Formula",
      "attributes": {
        "usage": "每服半钱，竹叶汤调下。"
      }
    },
    {
      "name": "牛黄散",
      "type": "Formula",
      "attributes": {
        "usage": "每度用药半钱，先于重舌上以披针披破出血，用盐汤漱口，然后掺药于舌上，咽津。"
      }
    }
  ],
