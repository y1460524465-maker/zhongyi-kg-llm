{
  "entities": [
    {
      "name": "京大戟",
      "type": "Herb",
      "attributes": {
        "alias": "邛钜,紫大戟,下马仙,京大戟",
        "effect": "泻水遂饮，消肿散结",
        "indication": "水饮泛溢，水肿喘满，胸腹积水，痰饮结聚，痈肿疮毒，痰凝结核",
        "taboo": "患虚寒阴水及孕妇忌服。体弱者慎用。反甘草。反芫花、海藻。畏菖蒲、芦草、鼠屎。小豆为之使。恶薯蓣。得枣则不损脾。脾胃肝肾虚寒，阴水泛滥，犯之立毙",
        "dosage": "内服：煎汤，0.5~3g；或入丸、散。外用：适量，研末或熬膏敷；或煎水熏洗",
        "processing": "拣去杂质，用水洗净，润透，切段或切片，晒干。醋大戟：取大戟段或片，加醋浸拌，置锅内用文火煮至醋尽，再炒至微干，取出，晒干。（大戟100斤，用醋30-50斤）",
        "traits": "本品呈不整齐的长圆锥形，略弯曲，常有分枝，长10～20cm，直径1.5～4cm。表面灰棕色或棕褐色，粗糙，有纵皱纹、横向皮孔及支根痕。顶端略膨大，有多数茎基及芽痕。质坚硬，不易折断，断面类白色或淡黄色，纤维性。气微，味微苦涩",
        "origin": "大戟科植物大戟Euphorbia pekinensis Rupr.的干燥根",
        "place": "分布于全国除新疆、广东、海南、广西、云南、西藏外各地"
      }
    }
  ],
