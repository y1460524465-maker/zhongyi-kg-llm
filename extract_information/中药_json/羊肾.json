  "entities": [
    {
      "name": "羊肾",
      "type": "Herb",
      "attributes": {
        "alias": "羊肾子, 羊腰子",
        "origin": "牛科动物山羊或绵羊的肾",
        "effect": "补肾气，益精",
        "indication": "肾虚劳损，腰脊疼痛，足膝痿弱，耳聋，消渴，阳萎，尿频，遗尿",
        "dosage": "内服：1~2枚，煮食或煎汤，或入丸、散",
        "processing": "炮羊肾一双，去脂，细切，于豉汁中以五味、米糅如常法作羹食，作粥亦得"
      }
