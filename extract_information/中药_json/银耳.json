{
  "entities": [
    {
      "name": "银耳",
      "type": "Herb",
      "attributes": {
        "alias": "白木耳、白耳、桑鹅、五鼎芝、白耳子",
        "effect": "补肺益气，养阴润燥",
        "indication": "虚劳咳嗽，痰中带血，虚热口渴；病后体虚，肺虚久咳，痰中带血，崩漏，大便秘结，高血压病，血管硬化",
        "dosage": "内服：煎汤，3~10g；或炖冰糖、肉类服",
        "taboo": "风寒咳嗽者及湿热酿痰致咳者禁用",
        "property_flavor": "气微，味淡",
        "traits": "子实体由数片至10余片薄而多皱褶的瓣片组成，呈菊花形、牡丹花形或绣球形，直径3~15cm，白色或类黄色，表面光滑，有光泽，基蒂黄褐色。角质，硬而脆。浸泡水中膨胀，有胶质",
        "origin": "真菌类银耳科银耳属植物银耳Tremella fuciformis Berk.以子实体入药。春秋采收，用老斑竹浸猪油制成竹刀采割，将鲜银耳以清水洗净后，晒干即成",
        "processing": "银耳5克，浸泡发开后，放入碗中，加少量水，隔水蒸一个小时，再加适量冰糖，继续蒸至稠羹状，一次吃完。每晚睡前服用"
      }
    },
