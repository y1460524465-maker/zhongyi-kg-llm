      "name": "蘘荷",
      "type": "Herb",
      "attributes": {
        "alias": "嘉草、猼月、蒚蒩、芋渠、覆葅、阳藿、阳荷、山姜、观音花、野老姜、土里开花、野生姜、野姜、莲花姜",
        "effect": "活血调经，镇咳祛痰，消肿解毒",
        "indication": "妇女月经不调，老年咳嗽，疮肿，瘰疬，目赤，喉痹，痛经，跌打损伤，痈疽肿毒",
        "processing": "夏、秋季采收，鲜用或切片晒干；或以铜刀刮去粗皮，细切，研膏，取汁炼煎",
        "dosage": "内服：煎汤，6-15g；或研末；或鲜品绞汁。外用：适量，捣敷；捣汁含漱或点眼",
        "property_flavor": "味淡微辛",
        "origin": "姜科植物蘘荷的根茎",
        "place": "江苏、安徽、浙江、江西、湖北、湖南等地",
        "traits": "根茎肥厚，圆柱形，淡黄色，茎呈不规则长条形，结节状，弯曲，表面灰棕黄色，有纵皱纹，气香"
      }
    }
