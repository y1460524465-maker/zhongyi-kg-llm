{
  "entities": [
    {
      "name": "赤石脂",
      "type": "Herb",
      "attributes": {
        "alias": "赤符、红高岭、赤石土、吃油脂、红土",
        "effect": "涩肠，止血，收湿，生肌",
        "indication": "久泻，久痢，便血，脱肛，遗精，崩漏，带下，溃疡不敛",
        "taboo": "不宜与肉桂同用。有湿热积滞者忌服。孕妇慎服。",
        "usage": "9～12g。外用适量，研末敷患处。",
        "origin": null,
        "place": null,
        "processing": "赤石脂：除去杂质，打碎或研细粉。煅赤石粉：取赤石脂细粉，用醋调匀，搓条，切段，干燥，放无烟的炉火或坩锅内煅烧，煅至红透。用时捣碎。",
        "property_flavor": null,
        "traits": null,
        "dosage": null,
        "meridian": null
      }
    },
