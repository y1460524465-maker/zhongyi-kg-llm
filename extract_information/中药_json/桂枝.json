{
  "entities": [
    {
      "name": "桂枝",
      "type": "Herb",
      "attributes": {
        "effect": "发汗解肌，温经通脉",
        "indication": "风寒表证，肩背肢节酸疼，胸痹痰饮，经闭癥瘕",
        "dosage": "煎汤1.5~6g，大剂量，可用至15~30g；或入丸、散",
        "taboo": "热病高热，阴虚火旺，血热妄行者禁服",
        "processing": "8～7月间剪取嫩枝，截成长约15或30～100厘米的小段，晒干",
        "traits": "枝长圆柱形，多分枝，长30~70cm，粗端直径0.3~1cm。表面棕色或红棕色，有细皱纹及小疙瘩状叶痕、枝痕和芽痕，皮孔点状或点状椭圆形。制裁硬而脆，易折断，断面皮部红棕色，可见一淡黄色石细胞环带，木部黄白色至浅黄棕色，髓部略呈方形。有特异香气，味甜、微辛，皮部味较浓。以枝条嫩细均匀，色红棕，香气浓者为佳。"
      }
    },
