    {
      "name": "桂枝汤",
      "type": "Formula",
      "attributes": {
        "usage": "以水七升，微火煮取三升，去滓，适寒温，服一升；服巳须臾，吸热稀粥一升余，以助药力，温覆令一时许，遍身漐漐微似有汗者益佳",
        "indication": "太阳中风，阳浮而阴弱，阳浮者，热自发，阴弱者，汗自出，啬啬恶寒，渐渐恶风，翕翕发热，鼻鸣干呕"
      }
    },
    {
      "name": "桂枝附子汤",
      "type": "Formula",
      "attributes": {
        "usage": "以水六升，煮取二升，去滓，分温三服",
        "indication": "伤寒八九日，风湿相搏，身体疼烦，不能自转侧，不呕不渴，脉浮虚而涩"
      }
    },
    {
      "name": "桂枝芍药知母汤",
      "type": "Formula",
      "attributes": {
        "usage": "以水七升，煮取二升，温服七合，日三服",
        "indication": "诸肢节疼痛，身体尪羸，脚肿如脱，头眩短气，温温欲吐"
      }
    },
    {
      "name": "桂枝生姜枳实汤",
      "type": "Formula",
      "attributes": {
        "usage": "以水六升，煮取三升，分温三服",
        "indication": "心中痞，诸逆，心悬痛"
      }
    },
    {
      "name": "茯苓桂枝甘草大枣汤",
      "type": "Formula",
      "attributes": {
        "usage": "以甘澜水一斗，先煮茯苓，减二升；纳诸药，煮取三升，去滓，温服一升，日三服",
        "indication": "伤寒发汗后，其人脐下悸者，欲作奔豚"
      }
    },
    {
      "name": "黄芪桂枝五物汤",
      "type": "Formula",
      "attributes": {
        "usage": "以水六升，煮取二升，温服七合，日三服",
        "indication": "血痹阴阳俱微，寸口关上微，尺中小紧，外证身体不仁，如风痹状"
      }
    },
    {
      "name": "桂枝龙骨牡蛎汤",
      "type": "Formula",
      "attributes": {
        "usage": "以水七升，煮取三升，分温三服",
        "indication": "失精家少腹弦急，阴头寒，目眩，发落，脉极虚、芤迟，为清谷亡血失精，脉得诸芤动微紧"
      }
    },
    {
      "name": "小建中汤",
      "type": "Formula",
      "attributes": {
        "usage": "以水七升，煮取三升，去滓，内胶饴，更上微火消解，温服一升，日三服",
        "indication": "虚劳里急悸衄，腹中痛，梦失精，四肢酸疼，手足烦热，咽干口燥"
      }
    },
    {
      "name": "桂枝茯苓丸",
      "type": "Formula",
      "attributes": {
        "usage": "末之，炼蜜和丸如兔屎大。每日食前服一丸，不知，加至三丸",
        "indication": "妇人宿有癥病，经断未及三月而得漏下不止，胎动在脐上者，为癥痼害"
      }
    },
