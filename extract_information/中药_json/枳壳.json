{
  "entities": [
    {
      "name": "枳壳",
      "type": "Herb",
      "attributes": {
        "effect": "破气，行痰，消积",
        "indication": "胸膈痰滞，胸痞，胁胀，食积，噫气，呕逆，下痢后重，脱肛，子宫脱垂",
        "meridian": "肺经；脾经；肝经；胃经；大肠经",
        "property_flavor": "味苦、微酸",
        "usage": "内服：煎汤，3~9g；或入丸、散。外用：适量，煎水洗或炒热熨",
        "taboo": "气血弱者不可服。肺气虚弱者忌之；脾胃虚，中气不运而痰涌喘急者忌之；咳嗽不因于风寒入肺气壅者，服之反能作剧；咳嗽阴虚火炎者，服之立至危殆；一概胎前产后，咸不宜服。如肝肾阴亏，血损营虚，胁肋隐痛者，匆用也。下痢日久，中气虚陷，愈下愈坠、愈后重急迫者，勿用也。孕妇及气虚人忌用",
        "origin": "芸香科植物酸橙Citrus aurantium L.及其栽培变种的干燥未成熟果实"
      }
    },
    {
      "name": "酸橙",
