{
  "entities": [
    {
      "name": "款冬花",
      "type": "Herb",
      "attributes": {
        "alias": "冬花，款花，艾冬花，九九花",
        "effect": "润肺下气，止咳化痰",
        "indication": "用于新久咳嗽，喘咳痰多，劳嗽咳血",
        "property_flavor": "味微苦而辛",
        "processing": "拣去残梗、沙石、土块。蜜冬花：取拣净的款冬花同炼蜜加适量开水，拌匀，稍闷，放锅内用文火炒至微黄色、不粘手为度，取出放凉。",
        "dosage": "内服：煎汤，3~10g；或熬膏；或入丸、散",
        "taboo": "肺火燔灼，肺气焦满者不可用；阴虚劳嗽禁用",
        "origin": "菊科植物款冬Tussilago farfara L.的干燥花蕾",
        "meridian": null,
        "place": "分布于华北、西北及江西、湖北、湖南等地",
        "traits": null
      }
    },
