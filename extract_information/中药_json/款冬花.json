      "attributes": {
        "alias": null,
        "effect": null,
        "indication": "暴发咳嗽",
        "taboo": null,
        "usage": "上七味，粗捣筛，每服三钱匕，水一盏，煎至七分，去滓温服"
      }
    },
    {
      "name": "紫菀散",
      "type": "Formula",
      "attributes": {
        "alias": null,
        "effect": null,
        "indication": "久嗽不止",
        "taboo": null,
        "usage": "上药粗捣罗为散，每服三钱，以水一中盏，入生姜半分，煎至六分，去滓温服，日三、四服"
      }
    },
    {
      "name": "款花汤",
      "type": "Formula",
      "attributes": {
        "alias": null,
        "effect": null,
        "indication": "肺痈嗽而胸满振寒，脉数，咽干，大渴，时出浊唾腥臭，臭久吐脓如粳米粥状者",
        "taboo": null,
        "usage": "上作十剂，水煎服"
      }
    },
    {
      "name": "百花膏",
      "type": "Formula",
      "attributes": {
        "alias": null,
        "effect": null,
        "indication": "喘嗽不巳，或痰中有血",
        "taboo": null,
        "usage": "上等分为细末，炼蜜为丸，如龙眼大。每服一丸，食后临卧细嚼，姜汤咽下，噙化尤佳"
      }
    },
    {
      "name": "款冬花散",
      "type": "Formula",
      "attributes": {
        "alias": null,
        "effect": null,
        "indication": "久咳嗽",
        "taboo": null,
        "usage": "上五味，捣罗为散。每服三钱匕，水一盏，煎至六分，食后、（临）卧温服"
      }
    },
    {
      "name": "款冬花膏",
      "type": "Formula",
      "attributes": {
        "alias": null,
        "effect": null,
        "indication": "肺虚咳嗽",
        "taboo": null,
        "usage": "上各半两为细末，炼蜜丸。每两十丸。每服一丸，米饮下，食前"
      }
    },
    {
      "name": "四物款冬丸",
      "type": "Formula",
      "attributes": {
        "alias": null,
        "effect": null,
        "indication": "少儿咳嗽，昼差夜甚，初不得息，不能复啼",
        "taboo": null,
        "usage": "上药捣筛，蜜和如泥，取如枣核大，涂乳头，令儿饮之，日三"
      }
