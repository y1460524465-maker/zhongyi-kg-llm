{
  "entities": [
    {
      "name": "乌梢蛇",
      "type": "Herb",
      "attributes": {
        "alias": "乌蛇、乌花蛇、剑脊蛇、黑风蛇、黄风蛇、剑脊乌梢蛇",
        "effect": "祛风湿，通经络。治风湿顽痹，肌肤不仁，骨、关节结核，风疹疥癣，麻风，破伤风，小儿麻痹症。",
        "indication": "风湿顽痹，肌肤不仁，骨、关节结核，风疹疥癣，麻风，破伤风，小儿麻痹症",
        "origin": "游蛇科动物乌梢蛇除去内脏的全体",
        "place": "产于浙江、江苏、湖北、安徽、四川等地",
        "processing": "乌梢蛇肉：去头及鳞片后，用黄酒闷透，除去皮骨，干燥。\n酒（炙）乌梢蛇：取净乌梢蛇段，照酒炙法炒干。每100kg乌梢蛇 ，用黄洒20kg。",
        "property_flavor": "气腥，味淡",
        "taboo": "忌鸡、鹅、鱼、肉、发物",
        "dosage": "内服：煎汤，9～12克；酒浸或焙干研末为丸、散。"
      }
    },
