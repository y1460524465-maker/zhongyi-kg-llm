    {
      "name": "路路通",
      "type": "Herb",
      "attributes": {
        "effect": "祛风通络，利水除湿",
        "indication": "肢体痹痛，手足拘挛，胃痛，水肿，胀满，经闭，乳少，痈疽，痔漏，疥癣，湿疹",
        "dosage": "3~10g",
        "taboo": "阴虚内热者不宜；虚寒血崩者勿服；经水过多及孕妇忌用",
        "processing": "冬季采摘，除去杂质，洗净，晒干"
      }
    },
