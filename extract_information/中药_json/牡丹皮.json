{
  "entities": [
    {
      "name": "牡丹皮",
      "type": "Herb",
      "attributes": {
        "alias": "丹皮、粉丹皮、木芍药、条丹皮、洛阳花",
        "effect": "清热凉血，和血消瘀",
        "indication": "热入血分，发斑，惊痫，吐、衄、便血，骨蒸劳热，经闭，癥瘕，痈疡，扑损",
        "taboo": "血虚有寒，孕妇及月经过多者慎服",
        "dosage": "内服：煎汤，6~9g；或入丸、散",
        "origin": "为毛茛科植物牡丹的根皮",
        "property_flavor": "气芳香，味微苦而涩",
        "processing": "丹皮：拣去杂质，除去木心，洗净，润透，切片，晾干。炒丹皮：将丹皮片入热锅内，不断翻炒至略有黄色焦斑时，取山，凉透。丹皮炭：取牡丹皮片入锅内，以武火炒至焦黑色，存性为度，喷淋清水，取出，凉透。"
      }
    },
