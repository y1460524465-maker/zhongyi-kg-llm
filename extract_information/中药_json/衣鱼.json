{
  "entities": [
    {
      "name": "衣鱼",
      "type": "Herb",
      "attributes": {
        "alias": "蟫、白鱼、蛃鱼、壁鱼、蠹鱼、铰剪虫",
        "effect": "利尿，通淋，祛风明目，解毒",
        "indication": "淋病，小便不利，小儿惊痫，疮疖，目翳",
        "dosage": "内服：煎汤或研末，5-10只。外用：适量，研末撒、调敷或点眼",
        "taboo": "畏芸草、莽草、莴苣；妊娠不可服",
        "origin": "为衣鱼科昆虫衣鱼的全虫",
        "traits": "体长而扁，长约1厘米。外被银色细鳞，头、胸、腹之区别不甚明显；头小，复眼细小，单眼缺如；触角细长，多节，成鞭状；口器虽退化，但善于咀嚼。胸部最阔，中胸及后胸各有气门1对；无翅，胸下有足3对。腹部10节，至尾部渐细，第1～8腹节各有气门1对。腹部末端有尾须3条，由多数环节组成。多生于古旧的房屋和古书中。畏光，好蠹食书籍、衣服及浆糊、胶质等物"
      }
    },
