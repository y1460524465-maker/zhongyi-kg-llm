    {
      "name": "芦荟",
      "type": "Herb",
      "attributes": {
        "effect": "清热，通便，杀虫",
        "indication": "热结便秘，妇女经闭，小儿惊痫，疳热虫积，癣疮，痔瘘，萎缩性鼻炎，瘰疬",
        "meridian": "肝经、胃经、大肠经",
        "property_flavor": null,
        "dosage": "0.6~1.5g",
        "processing": "全年可采。割取叶片，收集其流出的液汁，置锅内熬成稠膏，倾入容器，冷却凝固。",
        "origin": "百合科植物库拉索芦荟、好望角芦荟或斑纹芦荟的叶中的液汁经浓缩的干燥品",
        "taboo": "不入汤剂",
        "usage": "内服：入丸、散，或研末入胶囊，0.6~1.5g；不入汤剂。",
        "traits": "体轻，质硬，不易破碎，断面粗糙或显麻纹。富吸湿性。有特殊臭气，味极苦。",
