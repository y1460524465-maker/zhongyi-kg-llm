{
  "entities": [
    {
      "name": "蒲黄",
      "type": "Herb",
      "attributes": {
        "alias": "蒲厘花粉、蒲花、蒲棒花粉、蒲草黄",
        "effect": "凉血止血，活血消瘀",
        "indication": "生用治经闭腹痛，产后瘀阻作痛，跌扑血闷，疮疖肿毒；炒黑止吐血，衄血，崩漏，泻血，尿血，血痢，带下；外治重舌，口疮，聤耳流脓，耳中出血，阴下湿痒",
        "taboo": "不可多食，令人自利，不益极虚人；妊娠不可生用；一切劳伤发热，阴虚内热，无瘀血者禁用",
        "dosage": "内服：煎汤，5~10g，须包煎；或入丸散。外用：适量，研末撒或调敷。散瘀止痛多生用，止血每炒用，血瘀出血；生熟各半",
        "property_flavor": "味淡",
        "traits": "黄色细粉，质轻松，易飞扬，手捻之有润滑感，入水不沉。无臭。以色鲜黄，润滑感强，纯净者为佳"
      }
    },
