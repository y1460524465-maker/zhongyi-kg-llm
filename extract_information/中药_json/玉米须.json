{
  "entities": [
    {
      "name": "玉米须",
      "type": "Herb",
      "attributes": {
        "alias": "玉麦须、玉蜀黍蕊、棒子毛",
        "effect": "利尿消肿，泄热，平肝，利胆",
        "indication": "治肾炎水肿，脚气，黄疸肝炎，高血压，胆囊炎，胆结石，糖尿病，吐血衄血，鼻渊，乳痈",
        "meridian": "肾经；胃经；肝经；胆经",
        "origin": "禾本科植物玉蜀黍的花柱和柱头",
        "place": "全国各地广泛栽培",
        "property_flavor": null,
        "dosage": "内服：煎汤，15~30g；大剂量60~90g；或烧存性研末。外用：适量，烧烟吸入",
        "taboo": "煮食去苞须；不作药用时勿服",
        "processing": null,
        "traits": "本品常集结成疏松团簇，花柱线状或须状，完整者长至30mm，直径约0.5mm，淡绿色、黄绿色至棕红色，有光泽，略透明，柱头2裂，叉开，长至3mm，质柔软。以柔软、有光泽者为佳"
      }
    },
