  "entities": [
    {
      "name": "黄柏",
      "type": "Herb",
      "attributes": {
        "dosage": "内服：煎汤，3~9g；或入丸、散。外用：适量，研末调敷，或煎水浸洗。",
        "effect": "清热。燥湿，泻火，解毒。",
        "indication": "主治热痢，泄泻，消渴，黄疸，痿躄，梦遗，淋浊，痔疮，便血，亦白带下，骨蒸劳热，目赤肿痛，口舌生疮，疮疡肿毒。",
        "taboo": "脾虚泄泻，胃弱食少者忌服。",
        "property_flavor": "味苦",
        "processing": "剥取树皮后，除去粗皮，晒干。"
      }
    }
  ],
