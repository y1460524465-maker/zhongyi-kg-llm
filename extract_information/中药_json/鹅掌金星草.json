    {
      "name": "鹅掌金星草",
      "type": "Herb",
      "attributes": {
        "alias": "辟瘟草,鸭脚金星草,独脚金鸡,猪蹄叉,鸡脚叉,乌毛丁,鸭脚珠,鸭脚掌,三叉剑,双风尾草,七星箭,鹅脚伸筋,三叉风,盐挑草,鸭掌香,鸭掌星,鸭胶掌,鸭胶草,二叉曲,三叉虎,三滴血,鸭脚草",
        "effect": "清热,凉血,利尿,解毒",
        "indication": "伤寒热病,烦渴,惊风,扁桃体炎,细菌性痢疾,慢性肝炎,血淋,便血,痈肿疔疮",
        "dosage": "内服：煎汤，15-30g，大剂量可用至60g，鲜品加倍。外用：适量，研末撒；或鲜品捣敷",
        "origin": "水龙骨科植物金鸡脚的全草或带根全草",
        "processing": "秋季采收。晒干",
        "property_flavor": null,
        "meridian": null,
        "traits": null,
        "taboo": null,
        "place": "生于阴湿山沟旁或树林下。分布我国西南、中南、华东，北至陕西南部、山东半岛及旅顺等地。产江苏、四川、福建、江西、陕西等地"
      }
