    {
      "name": "王瓜根",
      "type": "Herb",
      "attributes": {
        "alias": "土瓜根、堵拉、耗子枕头、土花粉、山苦瓜",
        "effect": "泻热，生津，破血，消瘀",
        "indication": "热病烦渴，黄疸，热结便秘，或小便不利，经闭，癥癖，痈肿",
        "origin": "葫芦科植物王瓜的根",
        "dosage": "内服：煎汤，1.5～3钱（鲜者2～3两）；或捣汁"
      }
    },
    {
      "name": "土瓜根散",
      "type": "Formula",
      "attributes": {
        "alias": null,
        "effect": null,
        "indication": "伤寒烦渴不止",
        "taboo": null,
        "usage": "上药捣粗罗为散，每服四钱，以水一中盏，煎至六分，不计时候，去滓温服"
      }
    },
