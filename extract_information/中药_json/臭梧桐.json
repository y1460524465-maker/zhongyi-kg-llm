{
  "entities": [
    {
      "name": "臭梧桐",
      "type": "Herb",
      "attributes": {
        "alias": "臭桐、臭芙蓉、地梧桐、八角梧桐、楸叶常山、矮桐子、楸茶叶、百日红、臭桐柴",
        "effect": "祛风除湿，平肝降压，解毒杀虫",
        "indication": "风湿痹痛，半身不遂，高血压病，偏头痛，疟疾，痢疾，痔疮，痈疽疮疥",
        "dosage": "内服：煎汤，10~15g，鲜品30~60g；或浸酒；或入丸、散。外用：适量，煎水洗；或捣敷；研末掺或调敷",
        "taboo": "臭梧桐经高热煎煮后，降压作用减弱",
        "processing": "拣去杂草，用清水略浸，润透，切成 lcm长的小段，晒干，生用",
        "origin": "为马鞭草科植物臭梧桐的嫩枝及叶",
        "place": "分布于华北、华东、中南、西南等地"
      }
