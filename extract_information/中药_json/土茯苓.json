    {
      "name": "土茯苓",
      "type": "Herb",
      "attributes": {
        "alias": "草禹余粮，刺猪苓，硬饭，冷饭团，仙遗粮，土萆薢，山猪粪，山地栗，过冈尤、山牛，冷饭头、山归来，久老薯，毛尾薯，地胡苓，狗老薯，饭团根，土苓，狗朗头，尖光头，山硬硬，白葜，连饭，红土苓，山奇良",
        "effect": "解毒，除湿，利关节",
        "indication": "主治梅毒，淋浊，筋骨挛痛，脚气，疔疮，痈肿，瘰疬",
        "dosage": "内服：煎汤，10~60g",
        "taboo": "肝肾阴亏者勿服",
        "property_flavor": "味微甘、涩",
        "origin": "百合科植物光叶菝葜Smilax glabra Roxb.的干燥根茎",
        "place": null,
        "processing": "用水浸漂，夏季每日换水1次，春、秋每2日换水1次，冬季可3日换水1次，防止发臭，以泡透为度，捞出切片，及时干燥",
        "traits": null,
        "meridian": null
      }
    }
