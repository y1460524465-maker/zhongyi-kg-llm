{
  "entities": [
    {
      "name": "木竹子",
      "type": "Herb",
      "attributes": {
        "alias": "岭南倒捻子、岭南山竹子、木竹果、冬竹子、龙檬果、罗楝子、黄牙果、染牙果、竹橘",
        "origin": "藤黄科植物岭南山竹子的果实、果核、树皮",
        "place": "广西、广东",
        "property_flavor": "甘、平",
        "effect": "清热，利百脉，通调水脏，止渴生津，解暑，消酒；消炎止痛，收敛生肌",
        "indication": "治吐逆不食，关格闭拒不通，脾虚下陷，肛门坠脱不敛；清热，凉大肠，去积血，利耳目，治咳逆上气；烧伤，烫伤，湿疹，口腔炎，牙周炎，痈疮溃烂；铁砂入肉不出；小儿消化不良；拔子弹"
      }
    },
