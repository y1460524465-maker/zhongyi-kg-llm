{
  "entities": [
    {
      "name": "樟脑",
      "type": "Herb",
      "attributes": {
        "alias": "韶脑、潮脑、脑子、油脑、树脑",
        "effect": "通窍辟秽，温中止痛，利湿杀虫",
        "indication": "寒湿吐泻，胃腹疼痛，脚气，跌打损伤，疥癣，龋齿作痛",
        "taboo": "气虚者内服不宜过量，气虚及孕妇禁服。皮肤过敏者慎用",
        "usage": "内服：入丸、散，0.06~0.15g，不入煎剂。外用：适量，研末，或溶于酒中，或入软膏敷搽",
        "origin": "为樟科植物樟的根、干、枝、叶经蒸馏精制而成的颗粒状结晶",
        "property_flavor": "味初辛辣而后清凉",
        "traits": "白色的结晶性粉末或为无色透明的硬块，粗制品则略带黄色，有光亮，在常温中易挥发，火试能发生有烟的红色火焰而燃烧"
      }
    },
