{
  "entities": [
    {
      "name": "绿豆",
      "type": "Herb",
      "attributes": {
        "dosage": "内服：煎汤，15~30g，大剂量可用120g；研末；或生研绞汁。外用：适量，研末调敷。",
        "effect": "清热解毒，消暑，利水。",
        "indication": "主治暑热烦渴，水肿，泻利，丹毒，痈肿，解热药毒。",
        "taboo": "脾胃虚寒滑泄者忌之。",
        "property_flavor": null,
        "meridian": null,
        "origin": "为豆科植物绿豆的种子。",
        "processing": "立秋后种子成熟时采收，拔取全株，晒干，打下种子，簸净杂质。",
        "traits": "种子短矩圆形，长4~6mm。表面绿黄色、暗绿色、绿棕色，光滑而有光泽。种脐位于种子的一侧，白色，条形，约为种子长的1/2。种皮薄而坚韧，剥离后露出淡黄绿色或黄白色2片肥厚的子叶。气微，嚼之具豆腥气。以粒大、饱满、色绿者为佳。",
        "place": null
      }
    },
