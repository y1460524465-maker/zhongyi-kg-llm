{
  "entities": [
    {
      "name": "山柰",
      "type": "Herb",
      "attributes": {
        "dosage": "内服：煎汤，3~6克；或入丸、散。外用：捣敷，研末调敷或吹鼻。",
        "effect": "温中，消食，止痛。",
        "indication": "心腹冷痛，停食不化，跌打损伤，牙痛。用于胸隔胀满，脘腹冷痛。饮食不消。",
        "origin": "为姜科植物山柰的根茎。",
        "place": "分布于福建、台湾、广东、海南、广西、云南等地。",
        "processing": "12月至次年3月间，地上茎枯萎时，挖取二年生的根茎，洗去泥土，横切成片。用硫黄烟熏1天后，铺在竹席上晒干。切忌火烘，否则变成黑色，缺乏香气。",
        "property_flavor": "气芳香，味辛辣（但与姜味不同）。",
        "taboo": "阴虚血亏，胃有郁火者忌服。"
      }
    },
