    {
      "name": "五灵脂",
      "type": "Herb",
      "attributes": {
        "alias": "药本、寒号虫粪、寒雀粪",
        "effect": "行血止痛、止血",
        "indication": "心腹血气诸痛，妇女经闭，产后瘀血作痛；妇女血崩，经水过多，赤带不绝；蛇、蝎、蜈蚣咬伤",
        "dosage": "3~10g",
        "taboo": "血虚腹痛，血虚经闭，产妇去血过多发晕，心虚有火作痛，病属血虚无瘀滞者，皆所当忌",
        "processing": "净制、碎制、醋制、酒制",
        "origin": "鼯鼠科动物橙足鼯鼠和飞鼠等的干燥粪便",
        "property_flavor": null,
        "meridian": null,
        "place": "河北、山西、青海、甘肃、云南等地",
        "traits": null
      }
