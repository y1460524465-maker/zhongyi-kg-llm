{
  "entities": [
    {
      "name": "石上柏",
      "type": "Herb",
      "attributes": {
        "alias": "大叶菜，梭罗草，地梭罗，金龙草，龙鳞草，地侧柏，虾麻叶，锅巴草，岩青，岩扁柏，过路蜈蚣，大凤尾草，地柏草，深绿卷柏",
        "effect": "清热解毒，祛风利湿",
        "indication": "肺热咳喘，咽喉肿痛，目赤肿痛，湿热黄疸，热淋涩痛，乳痈肿痛，风湿热痹，水火烫伤",
        "property_flavor": "苦，寒",
        "meridian": "肝、胆、肺经",
        "dosage": "内服：煎汤，10-30g，鲜品倍量。外用：适量，研末敷；或鲜品捣敷",
        "origin": "本品为卷柏科植物深绿卷柏 Selaginella doederleinii Hieron.的干燥全草。四季可采，洗净晒干。",
        "place": "生于海拔200-1000m的林下湿地、溪边或石上。分布于西南及安徽、浙江、江西、福建、台湾、湖南、广东、广西等地。",
        "processing": "将原药除去杂质，喷潮，切短段,干燥，筛去灰屑。",
        "taboo": null,
        "traits": "本品呈段状。根极少，纤细，黄褐色。茎较少，扁柱形，具棱，宽约2mm；表面黄绿色至淡黄棕色，有的可见分枝，具稀疏而整齐排列的叶或叶痕。叶为羽状复叶，上表面深绿色，下表面淡绿色，多卷曲，分枝上的小叶有2型：背叶，2列，斜展，覆瓦状排列，卵状矩圆形，长约3mm，宽约2mm，顶端钝，不对称；腹叶小，2列，相互交叉排列，卵圆形，顶端锐尖。孢子囊穗，顶生，四棱形；孢子叶卵状三角形，头渐尖。体轻，质稍韧。气微，味淡。"
      }
    },
