{
  "entities": [
    {
      "name": "燕窝",
      "type": "Herb",
      "attributes": {
        "alias": "燕窝菜, 燕蔬菜, 燕菜, 燕根",
        "effect": "养阴润燥，益气补中，化痰止咳",
        "indication": "虚损，痨瘵，咳嗽痰喘，咯血，吐血，久痢，久疟，噎膈反胃",
        "property_flavor": "甘，平，无毒；甘淡，平；味甘咸，性平，有微毒",
        "taboo": "肺胃虚寒，湿痰停滞及有表邪者忌用",
        "traits": "呈不整齐的半月形，长约6.5～10厘米，宽约3～5厘米，凹陷成兜状。附着于岩石的一面较平，外面微隆起，附着面粘液凝成层排列较整齐，较隆起面细致，呈波状，窝的内部粗糙，呈丝瓜络样。质硬而脆，断面微似角质。入水则柔软而膨大。商品有白燕、毛燕、血燕之分。以白燕的品质为最佳。",
        "dosage": "内服：绢包，煎汤或蒸服，5-10g；或入膏剂"
      }
    },
