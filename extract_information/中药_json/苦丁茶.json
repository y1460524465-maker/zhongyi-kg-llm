    {
      "name": "苦丁茶",
      "type": "Herb",
      "attributes": {
        "alias": "毛叶黄牛木、黄浆果、土茶、茶盖、角刺茶",
        "effect": "散风热，清头目，除烦渴",
        "indication": "头痛，齿痛，目赤，聤耳，热病烦渴，痢疾",
        "usage": "内服：煎汤，3~9g；或入丸剂。外用：适量，煎水熏洗，或涂搽。",
        "processing": "去除杂质，阴干，备用",
        "origin": "主要为冬青科植物枸骨和大叶冬青的叶"
      }
    },
