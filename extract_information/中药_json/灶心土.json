  "entities": [
    {
      "name": "灶心土",
      "type": "Herb",
      "attributes": {
        "alias": "灶中黄土、釜下土、釜月下土、灶中土、灶内黄土、灶心土",
        "effect": "温中燥湿，止呕止血",
        "indication": "主治呕吐反胃，腹痛泄泻，吐血、衄血、便血、尿血，妇女妊娠恶阻，崩漏带下，痈肿溃疡",
        "usage": "内服:煎汤，15~30g；布包煎汤，澄清代水用，60~120g；或入散剂",
        "taboo": "阴虚失血及热证呕吐反胃忌服",
        "property_flavor": "味淡",
        "traits": "为不规则的块状，大小不一。全体红褐色，表面有刀削痕。质较硬，但易砸碎，并有粉末脱落，断面细软，色稍深，常有蜂窝状小孔。具烟熏气"
      }
    },
