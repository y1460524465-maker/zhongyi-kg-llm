  "entities": [
    {
      "name": "辛夷",
      "type": "Herb",
      "attributes": {
        "alias": "木笔花、望春花、春花、木兰、紫玉兰、白玉兰、二月花、广玉兰",
        "effect": "祛风，通窍",
        "indication": "治头痛，鼻渊，鼻塞不通，齿痛",
        "dosage": "内服：煎汤，3~10g，宜包煎；或入丸、散。外用：适量，研末搐鼻；或以其蒸馏水滴鼻",
        "property_flavor": "气芳香，味辛凉而稍苦",
        "taboo": "气虚人忌，头脑痛属血虚火炽者忌，齿痛属胃火者忌；气虚之人，虽偶感风寒，致诸窍不通者，不宜用",
        "origin": "为木兰科植物望春玉兰、玉兰、武当玉兰等的干燥花蕾",
        "processing": "拣净枝梗杂质，捣碎用；入药微炙，已开者劣，谢者不佳"
      }
