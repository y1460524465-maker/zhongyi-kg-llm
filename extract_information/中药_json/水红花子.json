    {
      "name": "水红花子",
      "type": "Herb",
      "attributes": {
        "alias": "水荭子、荭草实、河蓼子、川蓼子、水红子、爆花子、水泻花",
        "effect": "消瘀破积，健脾利湿。治胁腹癥积，水臌，胃疼，食少腹胀，火眼，疮肿，瘰疬。",
        "indication": "主治胁腹癥积，水臌，胃疼，食少腹胀，火眼，疮肿，瘰疬。",
        "taboo": "凡血分无瘀滞及脾胃虚寒者忌服。",
        "usage": "内服：煎汤，3~10g；研末、熬膏或浸酒。外用：适量，熬膏；或捣烂外敷。",
        "property_flavor": "味微辛",
        "processing": "8～10月间割取果穗，晒干，打落果实，除去杂质。"
      }
    },
